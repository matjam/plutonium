{
  "name": "plutonium",
  "displayName": "Plutonium",
  "description": "Syntax highlighting and pluto fmt formatting for the Plutonium systems language",
  "version": "0.1.0",
  "publisher": "matjam",
  "repository": {
    "type": "git",
    "url": "https://github.com/matjam/plutonium.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "plutonium",
    "pluto",
    "systems programming"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:plutonium"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "pluto fmt is not run in an untrusted workspace, and plutonium.plutoPath is read only from user settings there.",
      "restrictedConfigurations": [
        "plutonium.plutoPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Formatting runs pluto on the local machine; highlighting works everywhere."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "plutonium",
        "aliases": [
          "Plutonium",
          "plutonium"
        ],
        "extensions": [
          ".p"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plutonium",
        "scopeName": "source.plutonium",
        "path": "./syntaxes/plutonium.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Plutonium",
      "properties": {
        "plutonium.plutoPath": {
          "type": "string",
          "default": "pluto",
          "scope": "machine-overridable",
          "markdownDescription": "The `pluto` compiler used to format Plutonium source. A bare name is looked up on `PATH`; `~` and `${workspaceFolder}` are expanded."
        },
        "plutonium.formatTimeout": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "markdownDescription": "Milliseconds to wait for `pluto fmt` before giving up and leaving the document unchanged."
        }
      }
    },
    "configurationDefaults": {
      "[plutonium]": {
        "editor.insertSpaces": false,
        "editor.formatOnSave": true
      }
    }
  }
}
