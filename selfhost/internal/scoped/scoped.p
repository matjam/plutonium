// declaredIn reports whether the Scope variable v belongs to function fn
// (or to a scoped task's literal inside it): a Task call in a literal that
// is not a scoped task, on a Scope declared outside that literal, runs at
// a time the compiler cannot place, so it is not scoped.
func (a *analyzer) declaredIn(v *types2.Var, fn ast.Node) bool {
	return fn.Pos() <= v.Pos() && v.Pos() < fn.End()
}

// scope returns the record of Scope variable v.
func (a *analyzer) scope(v *types2.Var, fn ast.Node, outer *Task) *Scope {
	if sc := a.in.Scopes[v]; sc != nil {
		return sc
	}
	sc := pu.New(Scope{Var: v, Block: v.Parent(), Node: a.nodes[v.Parent()], Func: fn})
	if _, ok := sc.Node.(*ast.FuncType); ok {
		// The function's own block: its body.
		sc.Node = nil
	}
	// The function that declares it is the innermost task literal (or fn)
	// whose span holds the declaration.
	for t := outer; t != nil; t = t.Outer {
		if t.Lit.Pos() <= v.Pos() && v.Pos() < t.Lit.End() {
			sc.Func = t.Lit
			break
		}
	}
	if sc.Node == nil {
		sc.Node = sc.Func
	}
	a.in.Scopes[v] = sc
	return sc
}

// captures lists the local variables of enclosing functions that lit
// uses, in order of first use.
func (a *analyzer) captures(lit *ast.FuncLit) []*types2.Var {
	var out []*types2.Var
	seen := map[*types2.Var]bool{}
	ast.Inspect(lit.Body, func(n ast.Node) bool {
		id, ok := n.(*ast.Ident)
		if !ok {
			return true
		}
		v, ok := a.info.Uses[id].(*types2.Var)
		if !ok || seen[v] || v.IsField() || v.Pkg() == nil || v.Parent() == nil || v.Parent() == v.Pkg().Scope() {
			return true
		}
		if v.Pos() >= lit.Pos() && v.Pos() < lit.End() {
			return true
		}
		seen[v] = true
		out = compat.Append(out, v)
		return true
	})
	return out
}

// taken reports whether task t takes the captured variable v: v's block is
// nested inside the Scope's block and may end before t is joined.
func (a *analyzer) taken(v *types2.Var, t *Task) bool {
	B := t.Scope.Block
	V := v.Parent()
	if V == nil || V == B {
		return false
	}
	inside := false
	for s := V.Parent(); s != nil; s = s.Parent() {
		if s == B {
			inside = true
			break
		}
	}
	if !inside {
		return false
	}
	return !a.joinedIn(V, t)
}

// joinLoops computes t.JoinLoops: the innermost block between t's call
// and the Scope's block (that block left out) that joins t, and the number
// of t's loops inside it.
func (a *analyzer) joinLoops(t *Task) int {
	B := t.Scope.Block
	pos := t.Call.Pos()
	// The blocks from B in to the innermost one holding the call.
	var path []*types2.Scope
	for s := B; ; {
		var next *types2.Scope
		for i := 0; i < s.NumChildren(); i++ {
			c := s.Child(i)
			if n := a.nodes[c]; n != nil && n.Pos() <= pos && pos < n.End() {
				next = c
				break
			}
		}
		if next == nil {
			break
		}
		path = compat.Append(path, next)
		s = next
	}
	for i := len(path) - 1; i >= 0; i-- {
		V := path[i]
		node := a.nodes[V]
		if node.Pos() < t.Func.Pos() || t.Func.End() <= node.Pos() {
			return -1 // outside the function that makes the call
		}
		if _, ok := node.(*ast.FuncType); ok {
			return -1
		}
		if !a.joinedIn(V, t) {
			continue
		}
		n := 0
		for _, L := range t.Loops {
			if L.Stmt != node && node.Pos() <= L.Stmt.Pos() && L.Stmt.Pos() < node.End() {
				n++
			}
		}
		return n
	}
	return -1
}

// joinedIn reports whether a call s.Wait() in block V, after the statement
// that holds t's call, joins t on every path before V ends: no return,
// break, continue or goto between them can leave V first.
func (a *analyzer) joinedIn(V *types2.Scope, t *Task) bool {
	var list []ast.Stmt
	node := a.nodes[V]
	switch n := node.(type) {
	case *ast.BlockStmt:
		list = n.List
	case *ast.ForStmt:
		list = n.Body.List
	case *ast.RangeStmt:
		list = n.Body.List
	case *ast.CaseClause:
		list = n.Body
	case *ast.CommClause:
		list = n.Body
	case *ast.FuncLit:
		list = n.Body.List
	case *ast.FuncType:
		return false
	default:
		return false
	}
	// The innermost call of the chain of tasks that V holds: a task
	// started by a task is running while the task that started it is.
	pos := token.NoPos
	for o := t; o != nil; o = o.Outer {
		if node.Pos() <= o.Call.Pos() && o.Call.Pos() < node.End() {
			pos = o.Call.Pos()
			break
		}
	}
	k := -1
	for i, st := range list {
		if st.Pos() <= pos && pos < st.End() {
			k = i
			break
		}
	}
	if k < 0 {
		return false
	}
	for j := k + 1; j < len(list); j++ {
		if es, ok := list[j].(*ast.ExprStmt); ok {
			if c, ok := ast.Unparen(es.X).(*ast.CallExpr); ok {
				if name, recv := ScopeMethod(a.info.Selections, c); name == "Wait" && LocalScopeVar(a.info.Uses, recv) == t.Scope.Var {
					return !mayLeave(list[k:j])
				}
			}
		}
	}
	return false
}

// mayLeave reports whether the statements contain a jump or return (not
// inside a function literal), or a label a goto may reach: conservatively,
// anything that could leave the block before the next statement runs.
func mayLeave(list []ast.Stmt) bool {
	found := false
	for _, st := range list {
		ast.Inspect(st, func(n ast.Node) bool {
			switch n := n.(type) {
			case *ast.FuncLit:
				return false
			case *ast.ReturnStmt, *ast.LabeledStmt:
				found = true
			case *ast.BranchStmt:
				if n.Tok != token.FALLTHROUGH {
					found = true
				}
			}
			return !found
		})
	}
	return found
}

// A Loop is a loop around a scoped Task call.
type Loop struct {
	Stmt ast.Stmt
	// Var is the loop's variable when it is different in every iteration
	// (so that each task the loop starts takes a different one), or nil:
	// the key of a range over an integer, an array, a slice or a string, or
	// the variable i of for i := a; cond; i++ (i--, i += c, i -= c) that
	// the loop changes only in its post statement. A loop with a label
	// inside, which a goto could use to start a task twice in one
	// iteration, has none.
	Var *types2.Var
	// Step is c in i += c or i -= c, or nil.
	Step ast.Expr
	// StepCheck says Step is a variable, which the loop does not change:
	// lowering checks that it is positive before the task starts, so that
	// the iterations have different values of Var.
	StepCheck bool
}

// loop describes loop L.
func (a *analyzer) loop(L ast.Stmt) Loop {
	out := Loop{Stmt: L}
	var body *ast.BlockStmt
	var v *types2.Var
	switch L := L.(type) {
	case *ast.RangeStmt:
		body = L.Body
		id, ok := L.Key.(*ast.Ident)
		if !ok || L.Tok != token.DEFINE || id.Name == "_" {
			return out
		}
		v, _ = a.info.Defs[id].(*types2.Var)
		T := a.info.TypeOf(L.X)
		if T == nil {
			return out
		}
		switch u := T.Underlying().(type) {
		case *types2.Basic:
			if u.Info()&(types2.IsInteger|types2.IsString) == 0 {
				return out
			}
		case *types2.Slice, *types2.Array:
		case *types2.Pointer:
			if _, ok := u.Elem().Underlying().(*types2.Array); !ok {
				return out
			}
		default:
			return out
		}
	case *ast.ForStmt:
		body = L.Body
		init, ok := L.Init.(*ast.AssignStmt)
		if !ok || init.Tok != token.DEFINE || len(init.Lhs) != 1 {
			return out
		}
		id, ok := init.Lhs[0].(*ast.Ident)
		if !ok {
			return out
		}
		v, _ = a.info.Defs[id].(*types2.Var)
		switch post := L.Post.(type) {
		case *ast.IncDecStmt:
			if !a.names(post.X, v) {
				return out
			}
		case *ast.AssignStmt:
			if (post.Tok != token.ADD_ASSIGN && post.Tok != token.SUB_ASSIGN) || len(post.Lhs) != 1 || !a.names(post.Lhs[0], v) || !isInt64(v.Type()) {
				return out
			}
			step := post.Rhs[0]
			if tv := a.info.Types[step]; !tv.Value.IsNil() {
				if n, exact := constant.Int64Val(constant.ToInt(tv.Value)); !exact || n == 0 {
					return out
				}
			} else if sv := a.varOf(step); sv != nil && !isGlobalVar(sv) && !a.changes(L, sv) {
				out.StepCheck = true
			} else {
				return out
			}
			out.Step = step
		default:
			return out
		}
		if L.Cond != nil && a.changes(L.Cond, v) {
			return out
		}
	default:
		return out
	}
	if v == nil || a.changes(body, v) || hasLabel(body) {
		out.Step, out.StepCheck = nil, false
		return out
	}
	out.Var = v
	return out
}

// names reports whether e is an identifier for v.
func (a *analyzer) names(e ast.Expr, v *types2.Var) bool {
	return v != nil && a.varOf(e) == v
}

// varOf returns the variable e names, or nil.
func (a *analyzer) varOf(e ast.Expr) *types2.Var {
	id, ok := ast.Unparen(e).(*ast.Ident)
	if !ok {
		return nil
	}
	v, _ := a.info.Uses[id].(*types2.Var)
	return v
}

func isGlobalVar(v *types2.Var) bool {
	return v.Pkg() != nil && v.Parent() == v.Pkg().Scope()
}

// changes reports whether n assigns to v, increments it, or takes its
// address.
func (a *analyzer) changes(n ast.Node, v *types2.Var) bool {
	found := false
	ast.Inspect(n, func(x ast.Node) bool {
		switch x := x.(type) {
		case *ast.AssignStmt:
			for _, l := range x.Lhs {
				if a.rootIs(l, v) {
					found = true
				}
			}
		case *ast.OrStmt:
			for _, l := range x.Lhs {
				if a.rootIs(l, v) {
					found = true
				}
			}
		case *ast.IncDecStmt:
			if a.rootIs(x.X, v) {
				found = true
			}
		case *ast.UnaryExpr:
			if x.Op == token.AND && a.rootIs(x.X, v) {
				found = true
			}
		case *ast.RangeStmt:
			if x.Tok == token.ASSIGN && (a.rootIs(x.Key, v) || a.rootIs(x.Value, v)) {
				found = true
			}
		}
		return !found
	})
	return found
}

// rootIs reports whether e is v or a field or element of it.
func (a *analyzer) rootIs(e ast.Expr, v *types2.Var) bool {
	for {
		switch x := ast.Unparen(e).(type) {
		case *ast.Ident:
			return a.info.Uses[x] == v || a.info.Defs[x] == v
		case *ast.SelectorExpr:
			e = x.X
		case *ast.IndexExpr:
			e = x.X
		default:
			return false
		}
	}
}

// hasLabel reports whether n holds a labeled statement outside function
// literals.
func hasLabel(n ast.Node) bool {
	found := false
	ast.Inspect(n, func(x ast.Node) bool {
		switch x.(type) {
		case *ast.FuncLit:
			return false
		case *ast.LabeledStmt:
			found = true
		}
		return !found
	})
	return found
}

// checkArith records the arithmetic of task t whose overflow lowering
// checks (Info.Checked): the post statements of its loops that step by
// more than one, and the additions, subtractions and multiplications in the
// index and slice expressions of its literal that use a loop variable.
func (a *analyzer) checkArith(t *Task) {
	vars := map[*types2.Var]bool{}
	for _, L := range t.Loops {
		if L.Var == nil {
			continue
		}
		vars[L.Var] = true
		if f, ok := L.Stmt.(*ast.ForStmt); ok {
			if as, ok := f.Post.(*ast.AssignStmt); ok {
				a.in.Checked[as] = true
			}
		}
	}
	for o := t.Outer; o != nil; o = o.Outer {
		for _, L := range o.Loops {
			if L.Var != nil {
				vars[L.Var] = true
			}
		}
	}
	if len(vars) == 0 {
		return
	}
	uses := func(e ast.Expr) bool {
		found := false
		ast.Inspect(e, func(n ast.Node) bool {
			if id, ok := n.(*ast.Ident); ok {
				if v, ok := a.info.Uses[id].(*types2.Var); ok && vars[v] {
					found = true
				}
			}
			return !found
		})
		return found
	}
	mark := func(e ast.Expr) {
		ast.Inspect(e, func(n ast.Node) bool {
			if b, ok := n.(*ast.BinaryExpr); ok && (b.Op == token.ADD || b.Op == token.SUB || b.Op == token.MUL) && uses(b) {
				if T, ok := a.info.TypeOf(b).Underlying().(*types2.Basic); ok && T.Info()&types2.IsInteger != 0 {
					a.in.Checked[b] = true
				}
			}
			return true
		})
	}
	ast.Inspect(t.Lit.Body, func(n ast.Node) bool {
		switch x := n.(type) {
		case *ast.IndexExpr:
			mark(x.Index)
		case *ast.SliceExpr:
			for _, b := range []ast.Expr{x.Low, x.High, x.Max} {
				if b != nil {
					mark(b)
				}
			}
		}
		return true
	})
}

// isInt64 reports whether T is int or int64, whose arithmetic lowering
// checks for overflow where Info.Checked says to.
func isInt64(T types2.Type) bool {
	b, ok := T.Underlying().(*types2.Basic)
	return ok && (b.Kind() == types2.Int || b.Kind() == types2.Int64)
}

// IsInt64 is isInt64, for the race check's windows.
func IsInt64(T types2.Type) bool { return isInt64(T) }

// StartsTaskWithFunc reports whether fn is a function the compiler knows
// starts a task with its func arguments without a task statement the
// analyses can see (the runtime's contract with the compiler, by name; spec
// section 12.12): rt.Go, rt.TaskJoined, rt.DispatchTimerFunc and
// time.AfterFunc. A func value that may be a closure of a frame must not
// reach one (section 18.3).
func StartsTaskWithFunc(fn *types2.Func) bool {
	if fn == nil || fn.Pkg() == nil {
		return false
	}
	switch compat.Concat(fn.Pkg().Path(), ".", fn.Name()) {
	case "pluto/rt.Go", "pluto/rt.TaskJoined", "pluto/rt.DispatchTimerFunc", "pluto/time.AfterFunc":
		return fn.Type().(*types2.Signature).Recv() == nil
	}
	return false
}
