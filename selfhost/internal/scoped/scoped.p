// IsScopeType reports whether T is pluto/sync.Scope.
func IsScopeType(T types2.Type) bool {
	n, ok := types2.Unalias(T).(*types2.Named)
	if !ok || n.Obj().Pkg() == nil {
		return false
	}
	return n.Obj().Pkg().Path() == "pluto/sync" && n.Obj().Name() == "Scope"
}

// ScopeMethod returns the name of the sync.Scope method a call calls
// ("Task", "Wait", "Drop") and the receiver expression, or "" if it calls
// none.
func ScopeMethod(selections map[*ast.SelectorExpr]*types2.Selection, call *ast.CallExpr) (string, ast.Expr) {
	se, ok := ast.Unparen(call.Fun).(*ast.SelectorExpr)
	if !ok {
		return "", nil
	}
	sel := selections[se]
	if sel == nil || sel.Kind() != types2.MethodVal {
		return "", nil
	}
	fn, ok := sel.Obj().(*types2.Func)
	if !ok || fn.Pkg() == nil || fn.Pkg().Path() != "pluto/sync" {
		return "", nil
	}
	recv := fn.Type().(*types2.Signature).Recv()
	if recv == nil {
		return "", nil
	}
	T := recv.Type()
	if p, ok := T.(*types2.Pointer); ok {
		T = p.Elem()
	}
	if !IsScopeType(T) {
		return "", nil
	}
	return fn.Name(), se.X
}

// LocalScopeVar returns the variable e names if it is a local variable or
// parameter of type sync.Scope (not a pointer to one), or nil.
func LocalScopeVar(uses map[*ast.Ident]types2.Object, e ast.Expr) *types2.Var {
	id, ok := ast.Unparen(e).(*ast.Ident)
	if !ok {
		return nil
	}
	v, ok := uses[id].(*types2.Var)
	if !ok || v.IsField() || v.Pkg() == nil || v.Parent() == nil || v.Parent() == v.Pkg().Scope() {
		return nil
	}
	if !IsScopeType(v.Type()) {
		return nil
	}
	return v
}

// Analyze finds the scoped tasks of every package of prog.
func Analyze(prog *load.Program) *Info {
	in := pu.New(Info{Tasks: map[*ast.CallExpr]*Task{}, Lits: map[*ast.FuncLit]*Task{}, Scopes: map[*types2.Var]*Scope{}, Unscoped: map[*ast.CallExpr]bool{}, Checked: map[ast.Node]bool{}})
	for _, p := range prog.Packages {
		a := &analyzer{in: in, info: p.Info, nodes: map[*types2.Scope]ast.Node{}}
		for n, s := range p.Info.Scopes {
			a.nodes[s] = n
		}
		for _, f := range p.Files {
			for _, d := range f.Decls {
				if fd, ok := d.(*ast.FuncDecl); ok && fd.Body != nil {
					a.function(fd, fd.Body)
				}
			}
		}
	}
	return in
}

type analyzer struct {
	in    *Info
	info  *types2.Info
	nodes map[*types2.Scope]ast.Node
}

// function finds the scoped tasks of one function: fn is its declaration
// or literal, body its body. Literals that are not scoped tasks are
// functions of their own.
func (a *analyzer) function(fn ast.Node, body *ast.BlockStmt) {
	a.walk(fn, body, nil, nil)
}

// walk visits n, which is in function fn, inside the literal of scoped
// task outer (or nil), with loops the loops around it, innermost first.
func (a *analyzer) walk(fn ast.Node, n ast.Node, outer *Task, loops []ast.Stmt) {
