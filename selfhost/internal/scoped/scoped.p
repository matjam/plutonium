	"selfhost/compat"
	"selfhost/internal/constant"
	"selfhost/internal/load"
	"selfhost/internal/syntax/ast"
	"selfhost/internal/syntax/token"
	"selfhost/internal/types2"
	"selfhost/pu"
)

// Info is what the analysis finds in a program.
type Info struct {
	Tasks  map[*ast.CallExpr]*Task
	Lits   map[*ast.FuncLit]*Task
	Scopes map[*types2.Var]*Scope
	// Unscoped are the Task calls on a Scope that is not local, or whose
	// argument is not a function literal: they start tasks as a go
	// statement does.
	Unscoped map[*ast.CallExpr]bool
	// Checked are the integer operations whose overflow lowering checks
	// (a panic, where Go would wrap): the steps i += c and i -= c of the
	// loops that start scoped tasks, and the arithmetic in the index and
	// slice expressions of the tasks' literals that uses those loops'
	// variables. The race check's partitions of slices rely on different
	// iterations giving different, non-wrapping indexes.
	Checked map[ast.Node]bool
}

// An Overlap is a check that lowering makes before each scoped Task call
// (language spec section 19.4, Memory reached through views): the race check
// accepted the task because it reaches the slices A and B, which may overlap,
// only in the same partition form (out[i] and in[i]), so the slices must
// start at the same element or not overlap. Both are slice variables of
// the same element type that the task's literal uses, named in it.
type Overlap struct {
	A, B *types2.Var
}

// Overlaps are the checks the race check found necessary, by Task call.
type Overlaps map[*ast.CallExpr][]Overlap

// A Scope is a local sync.Scope variable whose Task calls are scoped.
