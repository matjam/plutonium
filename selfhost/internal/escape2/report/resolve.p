// finding gathers what the message of fd is written from.
func (r *reporter) finding(fd solve.Finding) *finding {
	fn := r.p.Funcs[fd.Func]
	f := pu.New(finding{fd: fd, fn: fn, info: r.info(fd.Pos), path: r.enclosing(fd.Pos)})
	f.l = r.locOf(fn, fd)
	for _, w := range r.witness(fn, fd) {
