// limitDiag writes the message of a function the analysis gave up on: it
// holds more distinct pointers than the analysis follows, so it is
// rejected rather than accepted unchecked.
func (r *reporter) limitDiag(fd solve.Finding) *diag.Diagnostic {
	fn := r.p.Funcs[fd.Func]
	name := r.frameName(fn)
	if fn.Key.Lit != nil {
		name = compat.Concat("the function literal at ", r.basePos(fn.Key.Lit.Pos()))
	}
	return pu.New(diag.Diagnostic{
		Pos:  r.fset.Position(fd.Pos),
		Code: fd.Code,
		Msg:  compat.Concat("the escape analysis of ", name, " reached its limit: the function holds more distinct pointers than the analysis can follow"),
		Text: compat.Concat("The compiler checks that no pointer into a function's frame outlives the frame by following every pointer the function makes, stores and passes on. ", upperFirst(name), " makes or passes on more distinct pointers, through more fields and calls, than that check can follow, so the compiler cannot show that it is safe, and rejects it rather than compile it unchecked."),
		Fix:  pu.New(diag.Fix{Intro: compat.Concat("Split ", name, " into smaller functions, each with fewer pointers, fields and calls to follow.")}),
	})
