				return true
			}
		}
		return false
	case *types2.Array:
		return holdsPointers(u.Elem())
	}
	return true
}

// passed fills in a view passed to a callee that keeps it.
func (r *reporter) passed(e *viewErr, f *finding, in *eir.Instr) {
	e.sink = sinkCall
	e.pos = in.Pos
	c := in.Call
	ce := r.callExprFor(in)
	if c.Implicit == eir.ImplDrop {
		r.dropPassed(e, f, in)
		return
	}
	var cands []ast.Expr
	switch {
	case ce != nil && c.Implicit == eir.ImplNone:
		cands = callOperands(ce, f.info)
		if c.Kind == eir.CallFunc {
			cands = compat.Append(cands, ce.Fun)
		}
	default:
		// A call the source does not write (index sugar, a deferred or
		// range call): what the statement there passes.
		path := r.enclosing(in.Pos)
		if as, ok := innermost[*ast.AssignStmt](path); ok {
			cands = compat.Append(compat.Append(cands, as.Rhs...), as.Lhs...)
		} else if ce2, ok := innermost[*ast.CallExpr](path); ok {
			cands = callOperands(ce2, f.info)
			if ce == nil {
				ce = ce2
			}
		}
	}
	if c.Implicit == eir.ImplRangeIter {
		if rs, ok := innermost[*ast.RangeStmt](r.enclosing(in.Pos)); ok && rs.X != nil {
			e.pos = rs.X.Pos()
		}
	}
	callee, entry := r.through(f.fd.Callee, f.fd.Entry)
	e.callee = r.calleeLabel(f.fn, in, ce, callee, entry)
	e.expr = r.choose(f, cands, in.Pos)
	if variadicArg(ce, e.expr, f.info) {
		// A variadic argument is passed in an array the call makes; the
		// message names the view itself, as for any argument it cannot
		// write.
		e.expr = nil
	}
	e.calleeWhy = r.why(callee, entry, f.fn.Pkg, 0)
	if c.Kind == eir.CallContract && callee == eir.NoFunc {
		e.calleeWhy = r.contractWhy(in, entry)
	}
	if d, ok := r.deferredWhy(in, callee, entry, 0); ok {
		e.calleeWhy = d
	}
}

// dropPassed fills in a view kept by the drop of an owner, at the end of
// its scope or of its statement (section 18.6): the drop calls its Drop
// method with the owner's address.
func (r *reporter) dropPassed(e *viewErr, f *finding, in *eir.Instr) {
	callee, entry := r.through(f.fd.Callee, f.fd.Entry)
	e.calleeWhy = r.why(callee, entry, f.fn.Pkg, 0)
	what, end := r.dropped(f.fn, in)
	name := "the drop"
	if int(callee) < len(r.p.Funcs) {
		name = r.label(r.p.Funcs[callee], f.fn.Pkg)
	}
	if what != "" {
		e.callee = compat.Concat(name, " (called when ", what, " is dropped)")
		e.expr = pu.New(ast.UnaryExpr{OpPos: in.Pos, Op: token.AND, X: pu.New(ast.Ident{Name: what})})
	} else {
		e.callee = name
	}
	if end.IsValid() {
		e.pos = end
	}
}

// through follows a callee that the source does not write (a drop's glue,
// a wrapper) down to the function its summary entry comes from.
func (r *reporter) through(callee eir.FuncID, entry int) (eir.FuncID, int) {
	for i := 0; i < maxChain; i++ {
		if int(callee) >= len(r.p.Funcs) || entry < 0 {
			return callee, entry
		}
		g := r.p.Funcs[callee]
		if g.Key.Synth == nil {
			return callee, entry
		}
		sum := r.summaryOf(callee)
		if sum == nil || entry >= len(sum.Reasons) {
			return callee, entry
		}
		rs := sum.Reasons[entry]
		if rs.Site == noReason || rs.Callee == noReason {
			return callee, entry
		}
		callee, entry = eir.FuncID(rs.Callee), int(int32(rs.Entry))
	}
	return callee, entry
}

// unknownDst is the destination of a store the source does not show.
const unknownDst = "memory that lives longer"

// stored fills in a view stored by the function's own code.
func (r *reporter) stored(e *viewErr, f *finding) {
	e.sink = sinkStore
	st, ok := r.storeAt(f, f.path)
	for i := len(f.wit) - 1; i >= 0 && !ok; i-- {
		// No assignment at the finding: a store the witness leads to.
		st, ok = r.storeAt(f, r.enclosing(f.wit[i]))
	}
	if !ok && f.fn.Key.Range != nil {
		// The body of a range loop over a function hands the view to the
		// function the loop is in: its result, or a deferred call.
		outer := r.declaredAround(f.fn.Key.Range.Pos())
		if ret, isRet := innermost[*ast.ReturnStmt](f.path); isRet && len(ret.Results) > 0 {
			e.pos, e.expr = ret.Pos(), r.choose(f, ret.Results, token.NoPos)
			e.dst, e.where = compat.Concat("the result of ", outer), storeLoopBody
			return
		}
		if ds, isDefer := innermost[*ast.DeferStmt](f.path); isDefer {
			e.pos, e.expr = ds.Pos(), r.choose(f, compat.Append(callOperands(ds.Call, f.info), ds.Call.Fun), ds.Call.Pos())
			e.dst, e.where = compat.Concat("the calls ", outer, " defers"), storeLoopBody
			return
		}
	}
	if !ok {
		e.dst, e.where = unknownDst, storeHeap
		return
	}
	e.pos, e.expr = st.at, st.rhs
	if st.lhs == nil {
		e.dst, e.where, e.inMap = st.dst, storeHeap, st.inMap
		return
	}
	r.destination(e, f, st.lhs)
}

// destination fills in where a store into lhs goes, and why that place
// outlives the view.
func (r *reporter) destination(e *viewErr, f *finding, lhs ast.Expr) {
	text, global := destOf(lhs, f.info)
	e.dst = text
	if ix, ok := ast.Unparen(lhs).(*ast.IndexExpr); ok && f.info != nil {
		if _, isMap := tvType(f.info.Types[ix.X]).Underlying().(*types2.Map); isMap {
			e.inMap = "element"
		}
	}
	switch {
	case e.l.kind == lkStmtTemp:
		e.where = storeStmt
	case global:
		e.where = storeGlobal
	case f.fn.Key.Lit != nil && r.declaredOutside(lhs, f.fn.Key.Lit, f.info):
		e.where = storeOuter
		if p, owner := r.reachedThroughParam(lhs, f); p != nil && derefs(lhs, f.info) {
			e.where, e.via, e.viaFn = storeParam, p.Name(), owner
		}
	default:
		e.where = storeHeap
		if v := rootVar(lhs, f.info); v != nil && isParam(f.fn, v) && derefs(lhs, f.info) {
			e.where, e.via = storeParam, v.Name()
		}
	}
}

// A store is an assignment, declaration or literal element that stores a
// view.
type store struct {
	lhs   ast.Expr // the destination, nil for an element of a map literal
	rhs   ast.Expr // the value stored
	at    token.Pos
	dst   string // the destination when lhs is nil
	inMap string // "key" or "element" of a map literal, or ""
}

// storeAt finds, among path, the assignment or literal element that stores
// the view: its destination, the value, and where to report it.
func (r *reporter) storeAt(f *finding, path []ast.Node) (st store, ok bool) {
	for i := len(path) - 1; i >= 0; i-- {
		switch n := path[i].(type) {
		case *ast.AssignStmt:
			if len(n.Lhs) == len(n.Rhs) {
				v := r.choose(f, n.Rhs, token.NoPos)
				for k := range n.Rhs {
					if n.Rhs[k] != v {
						continue
					}
					if ix, isIx := ast.Unparen(n.Lhs[k]).(*ast.IndexExpr); isIx && f.info != nil {
						if _, isMap := tvType(f.info.Types[ix.X]).Underlying().(*types2.Map); isMap && r.choose(f, []ast.Expr{ix.Index, v}, token.NoPos) == ix.Index {
							return store{rhs: ix.Index, at: n.Pos(), dst: compat.Concat("a key of ", exprText(ix.X)), inMap: "key"}, true
						}
					}
					return store{lhs: n.Lhs[k], rhs: v, at: n.Pos()}, true
				}
			}
			if len(n.Lhs) > 0 && len(n.Rhs) > 0 {
				return store{lhs: n.Lhs[0], rhs: n.Rhs[0], at: n.Pos()}, true
			}
		case *ast.ValueSpec:
			if len(n.Names) == len(n.Values) && len(n.Names) > 0 {
				v := r.choose(f, n.Values, token.NoPos)
				for k := range n.Values {
					if n.Values[k] == v {
						return store{lhs: n.Names[k], rhs: v, at: v.Pos()}, true
					}
				}
			}
		case *ast.KeyValueExpr:
			if i == 0 || f.info == nil {
				continue
			}
			cl, isLit := path[i-1].(*ast.CompositeLit)
			if !isLit {
				continue
			}
			if _, isMap := tvType(f.info.Types[cl]).Underlying().(*types2.Map); !isMap {
				continue
			}
			if r.choose(f, []ast.Expr{n.Key, n.Value}, token.NoPos) == n.Key {
				return store{rhs: n.Key, at: n.Key.Pos(), dst: "a key of the map literal", inMap: "key"}, true
			}
			return store{rhs: n.Value, at: n.Value.Pos(), dst: "an element of the map literal", inMap: "element"}, true
		case *ast.FuncLit:
			return store{}, false
		}
	}
	return store{}, false
}

// rootVar returns the variable an expression such as p.f[i] starts at.
func rootVar(e ast.Expr, info *types2.Info) *types2.Var {
	if info == nil {
		return nil
	}
	for {
		switch x := e.(type) {
		case *ast.ParenExpr:
			e = x.X
		case *ast.SelectorExpr:
			e = x.X
		case *ast.IndexExpr:
			e = x.X
		case *ast.StarExpr:
			e = x.X
		case *ast.Ident:
			v, _ := info.Uses[x].(*types2.Var)
			if v == nil {
				v, _ = info.Defs[x].(*types2.Var)
			}
			return v
		default:
			return nil
		}
	}
}

// derefs reports whether a destination is reached through a pointer or a
// slice: *p, p.f with p a pointer, s[i].
func derefs(e ast.Expr, info *types2.Info) bool {
	for {
		switch x := e.(type) {
		case *ast.ParenExpr:
			e = x.X
		case *ast.StarExpr:
			return true
		case *ast.SelectorExpr:
			if isPointerish(tvType(info.Types[x.X])) {
				return true
			}
			e = x.X
		case *ast.IndexExpr:
			if isPointerish(tvType(info.Types[x.X])) {
				return true
			}
			e = x.X
		default:
			return false
		}
	}
}

func isPointerish(T types2.Type) bool {
	switch T.Underlying().(type) {
	case *types2.Pointer, *types2.Slice, *types2.Map:
		return true
	}
	return isBoxPtr(T)
}

// declaredOutside reports whether the variable a destination starts at is
// declared outside the function literal lit.
func (r *reporter) declaredOutside(lhs ast.Expr, lit *ast.FuncLit, info *types2.Info) bool {
	v := rootVar(lhs, info)
	return v != nil && !isGlobal(v) && !contains(lit, v.Pos())
}

// reachedThroughParam returns the parameter of the declared function
// around a literal that the variable a destination starts at holds (as
// the source assigns it), and that function's name.
func (r *reporter) reachedThroughParam(lhs ast.Expr, f *finding) (*types2.Var, string) {
	v := rootVar(lhs, f.info)
	decl, ok := innermost[*ast.FuncDecl](r.enclosing(f.fd.Pos))
	if v == nil || !ok || f.info == nil {
		return nil, ""
	}
	obj, _ := f.info.Defs[decl.Name].(*types2.Func)
	if obj == nil {
		return nil, ""
	}
	sig := obj.Type().(*types2.Signature)
	params := map[*types2.Var]bool{}
	if sig.Recv() != nil {
		params[sig.Recv()] = true
	}
	for i := 0; i < sig.Params().Len(); i++ {
		params[sig.Params().At(i)] = true
	}
	seen := map[*types2.Var]bool{}
	for v != nil && !seen[v] {
		if params[v] {
			return v, funcName(obj)
		}
		seen[v] = true
		var next *types2.Var
		ast.Inspect(decl, func(n ast.Node) bool {
			as, ok := n.(*ast.AssignStmt)
			if !ok || next != nil || len(as.Lhs) != len(as.Rhs) {
				return next == nil
			}
			for i, l := range as.Lhs {
				if id, ok := l.(*ast.Ident); ok && (f.info.Defs[id] == v || f.info.Uses[id] == v) {
					next = rootVar(as.Rhs[i], f.info)
				}
			}
			return next == nil
		})
		v = next
	}
	return nil, ""
}

// loopStore finds, in the loop whose iterations reuse what the view looks
// at, the assignment that keeps a carrier of the view in a variable
// declared outside the loop: the store the next iteration sees through.
func (r *reporter) loopStore(e *viewErr, f *finding) bool {
	at := f.l.pos
	if f.l.node != nil {
		at = f.l.node.Pos()
	}
	lp := r.loopAround(at)
	if lp == nil || f.info == nil {
		return false
	}
	var found *ast.AssignStmt
	var lhs, rhs ast.Expr
	ast.Inspect(lp, func(n ast.Node) bool {
		as, ok := n.(*ast.AssignStmt)
		if !ok || found != nil {
			return found == nil
		}
		for i, l := range as.Lhs {
			rv := as.Rhs[0]
			if len(as.Rhs) == len(as.Lhs) {
				rv = as.Rhs[i]
			}
			v := rootVar(l, f.info)
			if v == nil || contains(lp, v.Pos()) && !inForHeader(lp, v.Pos()) {
				continue
			}
			if f.l.node != nil && contains(rv, f.l.node.Pos()) || r.usesCarrier(f, rv) {
				found, lhs, rhs = as, l, rv
				return false
			}
		}
		return true
	})
	if found == nil {
		return false
	}
	e.pos, e.expr = found.Pos(), rhs
	r.destination(e, f, lhs)
	return true
}

func (r *reporter) usesCarrier(f *finding, e ast.Expr) bool {
	for v := range f.carr {
		if mentions(e, v, f.info) {
			return true
		}
	}
	return false
}

// inForHeader reports whether pos is in the init statement of a for loop:
// a variable declared there passes its value on to the next iteration.
func inForHeader(lp ast.Node, pos token.Pos) bool {
	fs, ok := lp.(*ast.ForStmt)
	return ok && fs.Init != nil && contains(fs.Init, pos)
}

// regionStore fills in the closure of a call in a loop kept past the
// iteration (E3101), reported at the call, as the lowerer reports it.
func (r *reporter) regionStore(e *viewErr, f *finding) {
	if f.l.node != nil {
		e.pos = f.l.node.Pos()
	}
	st, ok := r.storeAt(f, f.path)
	for i := len(f.wit) - 1; i >= 0 && !ok; i-- {
		st, ok = r.storeAt(f, r.enclosing(f.wit[i]))
	}
	if !ok {
		var tmp viewErr
		tmp.l = f.l
		if r.loopStore(&tmp, f) {
			if as, isAssign := innermost[*ast.AssignStmt](r.enclosing(tmp.pos)); isAssign {
				for i, rv := range as.Rhs {
					if rv == tmp.expr && i < len(as.Lhs) {
						st, ok = store{lhs: as.Lhs[i], rhs: rv, at: as.Pos()}, true
					}
				}
			}
		}
	}
	e.dst = "memory reached through a pointer"
	id, isID := ast.Unparen(lhsOrNil(st.lhs)).(*ast.Ident)
	if !ok || !isID || f.info == nil {
		return
	}
	v, _ := f.info.Uses[id].(*types2.Var)
	if v == nil {
		v, _ = f.info.Defs[id].(*types2.Var)
	}
	if v == nil {
		return
	}
	e.iterVar = v
	if fs, isFor := innermost[*ast.ForStmt](r.enclosing(e.pos)); isFor && fs.Init != nil && contains(fs.Init, v.Pos()) {
		e.dst = compat.Concat(v.Name(), ", a variable of the for statement (", r.basePos(v.Pos()), "), which passes its value on to the next iteration")
	} else {
		e.dst = compat.Concat(v.Name(), ", declared outside the loop (", r.basePos(v.Pos()), ")")
	}
}

func lhsOrNil(e ast.Expr) ast.Expr {
	if e == nil {
		return pu.New(ast.BadExpr{})
	}
	return e
}

// loopOf finds the loop whose iterations reuse what a view looks at, and
// for a closure the loop's variable it uses.
func (r *reporter) loopOf(e *viewErr, f *finding) {
	l := f.l
	at := l.pos
	if l.kind == lkClosure {
		for _, v := range l.captures {
			if lp := r.loopAround(v.Pos()); lp != nil && contains(lp, l.pos) {
				e.iterVar, at = v, v.Pos()
				break
			}
		}
	}
	if lp := r.loopAround(at); lp != nil {
		e.loop = lp
	}
}

// loopAround returns the innermost loop statement whose iterations hold a
// declaration at pos.
func (r *reporter) loopAround(pos token.Pos) ast.Node {
	path := r.enclosing(pos)
	for i := len(path) - 1; i >= 0; i-- {
		switch n := path[i].(type) {
		case *ast.ForStmt, *ast.RangeStmt:
			return n
		case *ast.FuncLit:
			if n.Pos() != pos { // a literal made at pos is in the loop around it
				return nil
			}
		}
	}
	return nil
}
