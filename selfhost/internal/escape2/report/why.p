// maxChain bounds the calls a reason follows down: a recursive chain is
// cut there, with what it has said so far.
const maxChain = 12

// noReason is the field value of a summary reason that names nothing.
const noReason = ^uint32(0)

// calleeLabel names the callee of a call as a message does: a static
// callee by name ("remember", "vec.(*Vec).Push"), and a dynamic call by
// the function value or method it calls, with the function the view
// reaches through it ("s.String (which may call main.(*S).String)").
// callee and entry are the function and summary entry the reason goes on
// with, when known.
func (r *reporter) calleeLabel(fn *eir.Func, in *eir.Instr, ce *ast.CallExpr, callee eir.FuncID, entry int) string {
	c := in.Call
	switch c.Kind {
	case eir.CallStatic:
		if int(c.Callee) < len(r.p.Funcs) {
			g := r.p.Funcs[c.Callee]
			if g.Key.Synth != nil && int(callee) < len(r.p.Funcs) {
				// A wrapper the source does not write: name what it calls.
				g = r.p.Funcs[callee]
			}
			return r.label(g, fn.Pkg)
		}
	case eir.CallContract:
		if obj := r.calledFunc(ce); obj != nil {
			return r.label(&eir.Func{Key: eir.FuncKey{Obj: obj}}, fn.Pkg)
		}
		if ce != nil {
			return shortText(ce.Fun)
		}
		return "the runtime"
	}
	// A dynamic call: the value called, and the function the reason goes
	// through.
	what := "the function value"
	if ce != nil {
		what = shortText(ce.Fun)
	}
	withPkg := c.Kind != eir.CallFunc
	if m := r.member(callee, entry); m != nil {
		return compat.Concat(what, " (which may call ", r.candidateName(m, withPkg), ")")
	}
	if int(callee) < len(r.p.Funcs) {
		return compat.Concat(what, " (which may call ", r.candidateName(r.p.Funcs[callee], withPkg), ")")
	}
	return what
}

// calledFunc returns the declared function a call written in the source
// calls, or nil.
func (r *reporter) calledFunc(ce *ast.CallExpr) *types2.Func {
	if ce == nil {
		return nil
	}
	info := r.info(ce.Pos())
	if info == nil {
		return nil
	}
	switch f := ast.Unparen(ce.Fun).(type) {
	case *ast.Ident:
		obj, _ := info.Uses[f].(*types2.Func)
		return obj
	case *ast.SelectorExpr:
		if sel := info.Selections[f]; sel != nil {
			obj, _ := sel.Obj().(*types2.Func)
			return obj
		}
		obj, _ := info.Uses[f.Sel].(*types2.Func)
		return obj
	}
	return nil
}

// member returns the function a virtual function of the dynamic-call rule
// takes the reason of a summary entry from: the candidate that made it.
func (r *reporter) member(callee eir.FuncID, entry int) *eir.Func {
	if int(callee) < len(r.p.Funcs) || callee == eir.NoFunc || entry < 0 {
		return nil
	}
	sum := r.summaryOf(callee)
	if sum == nil || entry >= len(sum.Reasons) {
		return nil
	}
	rs := sum.Reasons[entry]
	if rs.Callee != noReason && int(rs.Callee) < len(r.p.Funcs) {
		return r.p.Funcs[rs.Callee]
	}
	return nil
}

// dropped names what an implicit drop call drops: the variable whose
// address it takes, or the expression that made the temporary; and where
// the drop is, as the source shows it: the end of the variable's block, or
// the end of the expression.
func (r *reporter) dropped(fn *eir.Func, in *eir.Instr) (string, token.Pos) {
