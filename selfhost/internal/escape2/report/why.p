		return "", token.NoPos
	}
	o := &fn.Objects[d.Obj]
	path := r.enclosing(o.Pos)
	if o.Var != nil {
		if b, ok := innermost[*ast.BlockStmt](path); ok {
			return o.Var.Name(), b.Rbrace
		}
		return o.Var.Name(), token.NoPos
	}
	for _, n := range path {
		if ce, ok := n.(*ast.CallExpr); ok && ce.Pos() == o.Pos {
			return exprText(ce), ce.End()
		}
	}
	if e := r.exprAt(o.Pos); e != nil {
		return exprText(e), e.End()
	}
	return "", token.NoPos
}

