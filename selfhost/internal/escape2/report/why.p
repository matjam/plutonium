// contractFunc returns the library's function of a contract call, when it
// has one in the program (a function the lowerer expands inline has a
// declaration, and often a body that states what it does).
func (r *reporter) contractFunc(in *eir.Instr) *eir.Func {
	obj := r.calledFunc(r.callExprFor(in))
	if obj == nil {
		return nil
	}
	if id := r.p.Lookup(eir.FuncKey{Obj: obj.Origin()}); id != eir.NoFunc {
		return r.p.Funcs[id]
	}
	return nil
}

// storeDest describes the destination of the store at pos, from the
// source: "package variable keepS", "cache[0]".
func (r *reporter) storeDest(pos token.Pos) string {
	if !pos.IsValid() {
		return ""
	}
	path := r.enclosing(pos)
	info := r.info(pos)
	for i := len(path) - 1; i >= 0; i-- {
		switch n := path[i].(type) {
		case *ast.AssignStmt:
			if len(n.Lhs) > 0 {
				t, _ := destOf(n.Lhs[0], info)
				return t
			}
		case *ast.ValueSpec:
			if len(n.Names) > 0 {
				t, _ := destOf(n.Names[0], info)
				return t
			}
		case *ast.FuncLit, *ast.FuncDecl:
			return ""
		}
	}
	return ""
}

// keyDesc describes the pointers a summary key names, in g's terms: "p",
// "a pointer loaded from p.next", "a pointer reachable from p".
func (r *reporter) keyDesc(g *eir.Func, k domain.Key) string {
	name := inputName(g, k.Input())
	switch {
	case k.GE(), k.Deep():
		return compat.Concat("a pointer reachable from ", name)
	case k.Path() == domain.Root:
		return name
	}
	if r.env == nil {
		return compat.Concat("a pointer reachable from ", name)
	}
	if r.env.Paths().Loads(k.Path()) == 0 {
		// An offset into what the input points to: the input's own pointer.
		return name
	}
	if k.Input() < len(g.Inputs) {
		if _, ok := types2.Unalias(g.Inputs[k.Input()].Type).(*types2.TypeParam); ok {
			// Of a type parameter's value the source shows no fields.
			return compat.Concat("a pointer reachable from ", name)
		}
	}
	text, how := r.renderPath(g, k)
	switch how {
	case pathValue:
		return text
	case pathReachable:
		return compat.Concat("a pointer reachable from ", name)
	}
	return compat.Concat("a pointer loaded from ", text)
}

// inputName names input i of g: its parameter or receiver, or for a
// function literal's record the variables it uses.
func inputName(g *eir.Func, i int) string {
	if i < len(g.Inputs) {
		if v := g.Inputs[i].Var; v != nil && v.Name() != "" && v.Name() != "_" {
			return v.Name()
		}
		if g.Inputs[i].Var == nil && (g.Key.Lit != nil || g.Key.Range != nil) {
			return "a variable it uses"
		}
	}
	return compat.Concat("argument ", strconv.Itoa(i+1))
}

// A pathText says how renderPath could write a path.
type pathText uint8

const (
	pathExact     pathText = iota // the expression is what the pointers are loaded from
	pathValue                     // the path stays in the value the expression names (a function value's record)
	pathReachable                 // the path goes on where the source has no expression: reachable from it
)

// renderPath writes a key's access path in Go syntax, the loads implicit as
// Go writes them: p.next.val, *f, args[i]. A path into what an interface
// holds, or past the types the source shows, is written as far as the
// source can, and said to be reachable from there.
func (r *reporter) renderPath(g *eir.Func, k domain.Key) (string, pathText) {
	i := k.Input()
	expr := inputName(g, i)
	var T types2.Type
	if i < len(g.Inputs) {
		T = g.Inputs[i].Type
	}
	isAddr := false
	steps := r.env.Paths().Steps(k.Path())
	for n, step := range steps {
		if T != nil && !isAddr {
			if _, ok := T.Underlying().(*types2.Signature); ok {
				// A function value: the source shows what its record holds
				// only as what calling it uses. One load is the value's own
				// pointer (*f); more stay in the value.
				if loadsIn(steps[n:]) == 1 {
					return compat.Concat("*", expr), pathExact
				}
				return expr, pathValue
			}
			if isInterface(T) {
				// What an interface holds.
				return expr, pathReachable
			}
		}
		switch step {
		case domain.StepLoad, domain.StepCap:
			switch {
			case isAddr:
				isAddr = false
			case T != nil && pointerElem(T) != nil:
				expr, T = compat.Concat("(*", expr, ")"), pointerElem(T)
			case T != nil && elemType(T) != nil:
				expr, T = compat.Concat(expr, "[i]"), elemType(T)
			default:
				return expr, pathReachable
			}
		case domain.StepElem:
			el := elemOf(T)
			if el == nil {
				return expr, pathReachable
			}
			expr, T, isAddr = compat.Concat(expr, "[i]"), el, true
		default:
			S := T
			if !isAddr && T != nil {
				if el := pointerElem(T); el != nil {
					S = el
				}
			}
			var st *types2.Struct
			if S != nil {
				st, _ = S.Underlying().(*types2.Struct)
			}
			if st == nil || int(step) >= st.NumFields() {
				return expr, pathReachable
			}
			expr, T, isAddr = compat.Concat(expr, ".", st.Field(int(step)).Name()), st.Field(int(step)).Type(), true
		}
	}
	if strings.HasPrefix(expr, "(*") && strings.HasSuffix(expr, ")") && strings.Count(expr, "(") == 1 {
		expr = compat.Concat("*", strings.Slice(expr, 2, len(expr)-1))
	}
	if isAddr {
		return compat.Concat("&", expr), pathExact
	}
	return expr, pathExact
}

func loadsIn(steps []domain.Step) int {
	n := 0
	for _, s := range steps {
		if domain.IsLoad(s) {
			n++
		}
	}
	return n
}

// elemOf returns the element type of an array, slice, or pointer to an
// array, or nil.
func elemOf(T types2.Type) types2.Type {
	if T == nil {
		return nil
	}
	if el := elemType(T); el != nil {
		return el
	}
	if p := pointerElem(T); p != nil {
		return elemType(p)
	}
	return nil
}

func pointerElem(T types2.Type) types2.Type {
	if T == nil {
		return nil
	}
	if p, ok := T.Underlying().(*types2.Pointer); ok {
		return p.Elem()
	}
	return nil
}

func elemType(T types2.Type) types2.Type {
	if T == nil {
		return nil
	}
	switch u := T.Underlying().(type) {
	case *types2.Slice:
		return u.Elem()
	case *types2.Array:
		return u.Elem()
	}
	return nil
}
