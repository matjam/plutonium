	s := ev.set(r)
	ev.cur, ev.base = cur, base
	return s
}

func (ev *flowEval) eval(r eir.Reg) *fset {
	if call, ok := ev.res[r]; ok {
		return ev.result(call, r)
	}
	if int(r) >= len(ev.defs) || ev.defs[r] == nil {
		return topSet
	}
	in := ev.defs[r]
	out := pu.New(fset{})
	join := func(rs ...eir.Reg) {
		for _, x := range rs {
			out.add(ev.set(x))
		}
	}
	switch in.Op {
	case eir.OpClosure:
		if in.Callee == eir.NoFunc || int(in.Callee) >= len(ev.fl.p.Funcs) {
			return topSet
		}
		out.addID(in.Callee)
	case eir.OpMethodVal:
		if in.Method == nil {
			return topSet
		}
		ids := ev.fl.methodVals[in.Method.Origin()]
		if len(ids) == 0 {
			return topSet
		}
		for _, id := range ids {
			out.addID(id)
		}
	case eir.OpInput:
		if in.Index >= len(ev.fl.in[ev.f.ID]) {
			return topSet
		}
		out.add(&ev.fl.in[ev.f.ID][in.Index])
	case eir.OpCopy:
		join(in.X)
	case eir.OpPhi:
		join(in.Args...)
	case eir.OpLoad:
		// A load from a frame object, the function's own or one a capture
		// reaches: its contents, if it is tracked.
		if objs, isPlace, tracked := ev.fl.cp.placeObjs(ev.f, ev.defs, in.X); isPlace {
			if !tracked {
				return topSet
			}
			for _, o := range objs {
				out.add(ev.fl.cp.content(o))
			}
			return out
		}
		// A load of a field of the closure's record: what was captured
		// there by value.
		if c, ok := recordField(ev.f, ev.defs, in.X); ok {
			out.add(ev.fl.cp.value(c))
			return out
		}
		return topSet
	default:
		return topSet
	}
	return out
}

// result is what result register r of call may hold.
func (ev *flowEval) result(call *eir.Instr, r eir.Reg) *fset {
	c := call.Call
	j := -1
	for i, x := range c.Results {
		if x == r {
			j = i
		}
	}
	var callees []eir.FuncID
	switch c.Kind {
	case eir.CallStatic:
		callees = []eir.FuncID{c.Callee}
	case eir.CallFunc:
		t := ev.fl.targets[c]
		if t == nil {
			t = ev.sub(c.Target)
		}
		if t != nil && !t.top {
			callees = setIDs(t.ids)
		} else {
			callees = ev.fl.c.funcs(c.Sig)
		}
	case eir.CallIface, eir.CallTypeParam:
		callees = ev.fl.c.of(ev.f, c)
	default:
		return topSet
	}
	out := pu.New(fset{})
	for _, g := range callees {
		if g == eir.NoFunc || int(g) >= len(ev.fl.p.Funcs) || ev.fl.p.Funcs[g].Bodyless || j >= len(ev.fl.ret[g]) {
			return topSet
		}
		out.add(&ev.fl.ret[g][j])
	}
	return out
}
