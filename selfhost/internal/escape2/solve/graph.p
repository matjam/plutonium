	s.tjLow.push(s.a, idx|tjOnStack)
	s.tjStack.push(s.a, uint64(n))
	for e := s.nodeEdges.s[n]; e != 0; e = s.edges.at(e - 1)[3] {
		w := s.edges.at(e - 1)
		if w[1] != xw(xID, 0, false) || w[2] != 0 {
			continue
		}
		m := s.find(uint32(w[0]))
		if s.nodeKind(m) != nkReg || m == n {
			continue
		}
