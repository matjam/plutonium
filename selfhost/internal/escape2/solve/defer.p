	// converts the reused buffer without allocating; only a new key is
	// copied.
	b := s.argBuf[:0]
	for _, k := range a.Keys {
		i := k.Input()
		if i < len(bind) && bind[i] != 0 {
			b = compat.AppendUint64(b, bind[i])
			b = compat.AppendUint64(b, uint64(k))
		}
	}
	if a.Heap {
		b = compat.AppendPlain(b, 'h')
	}
	s.argBuf = b
	if n, ok := s.argNodes[compat.String(b)]; ok {
		return n
	}
	n := s.newNode(nkPinned)
	s.argNodes[compat.String(b)] = n
	for _, k := range a.Keys {
		i := k.Input()
		if i < len(bind) && bind[i] != 0 {
			s.addEdge(s.keyNode(uint32(bind[i]), k), n, xw(xID, 0, false), 0)
		}
	}
	if a.Heap {
		s.addTok(n, heapTok)
	}
	return n
