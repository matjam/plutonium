		return // the default kept the whole value already
	}
	origin := s.f
	if dc.origin != s.f.ID {
		origin = s.prog.Funcs[dc.origin]
	}
	for _, cand := range s.env.Candidates(origin, siteCall(origin, dc.site)) {
		s.joinFallback(j, cand, true)
	}
