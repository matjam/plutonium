		return fb.emitCall(pu.New(Call{Kind: CallContract, Contract: contract.RingMethod, Sig: fn.Type().(*types2.Signature), Args: compat.AppendPlain(compat.Clone([]Reg{data}), args...), Implicit: ImplWrapper}), token.NoPos)
