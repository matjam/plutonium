	if isIfaceMethod(fn) {
		I := fb.recvFieldType(T, index)
		iv := fb.receiverFromData(data, T, index, I)
		return fb.emitCall(pu.New(Call{Kind: CallIface, Method: fn, Iface: I, Target: iv, Sig: fn.Type().(*types2.Signature), Args: args, Implicit: ImplWrapper}), token.NoPos)
