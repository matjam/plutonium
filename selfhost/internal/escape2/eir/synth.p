	if id == NoFunc {
		fb.b.errorf(token.NoPos, "method %s has no source", pu.Box(fn.Name()))
		return nil
	}
	return fb.emitCall(pu.New(Call{Kind: CallStatic, Callee: id, Sig: fn.Type().(*types2.Signature), Args: args, Implicit: ImplWrapper}), token.NoPos)
}

