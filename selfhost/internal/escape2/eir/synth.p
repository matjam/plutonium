	cur := T
	switch {
	case pointerElem(T) != nil:
		addr, cur = data, pointerElem(T)
	case fb.isDirect(T):
		o := fb.newObj(Object{Kind: ObjTemp, Type: T, Name: "recv"})
		addr = fb.addr(o)
		fb.store(addr, data, T)
