		if r.ext != ssa.OpInvalid {
			x = s.newValue(ssa.OpTrunc, s.l.scalarType(cs.results[0]), x)
		}
		return compat.Clone([]value{scalarValue(x, cs.results[0])})
	default:
		buf = s.cTemp(r, "cres")
		for k, t := range r.pieces {
			s.store(t, s.offPtr(buf, int64(8*k)), s.selectN(call, k+1, t))
		}
