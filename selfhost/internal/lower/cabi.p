// exportWrapper builds the body of a C entry point for the Plutonium
// function target: it takes its arguments the System V way, calls target
// with the internal ABI and returns the results the System V way.
func (s *fnState) exportWrapper(cs *cSig, target *ssa.Sym, sig *types2.Signature) {
	f := s.f
	s.gxBoundary = gxC
	f.ABI = ssa.ABIC
	f.Params = cs.flatParams
	f.ParamOnStack = cs.onStack
	f.Results = cs.flatResults
	idx := 0
	arg := func(t *ssa.Type) *ssa.Value {
		v := s.newValue(ssa.OpArg, t)
		v.AuxInt = int64(idx)
		idx++
		return v
	}
	var sretPtr *ssa.Value
	if cs.sret {
		sretPtr = arg(ssa.TPtr)
	}
	vals := compat.Make[value](len(cs.params))
	for i, p := range cs.params {
		if p.scalar != nil {
			x := arg(p.scalar)
			if p.ext != ssa.OpInvalid {
				x = s.newValue(ssa.OpTrunc, s.l.scalarType(p.typ), x)
			}
			vals[i] = scalarValue(x, p.typ)
			continue
		}
		tmp := s.cTemp(&p, "carg")
		for k, t := range p.pieces {
			s.store(t, s.offPtr(tmp, int64(8*k)), arg(t))
		}
		vals[i] = aggValue(tmp, p.typ)
	}
	var recv *value
	args := vals
	if sig.Recv() != nil {
		recv, args = &vals[0], vals[1:]
	}
	res := s.emitCall(callee{sym: target}, sig, recv, args, token.NoPos)
	if s.b == nil {
		return // target does not return
	}

	var out []*ssa.Value
	if r := cs.result; r != nil {
		var buf *ssa.Value
		switch {
		case cs.sret:
			buf = sretPtr
		case r.scalar != nil:
			x := s.leafValues(res[0], []leaf{{0, s.l.scalarType(cs.results[0])}})[0]
			if r.ext != ssa.OpInvalid {
				x = s.newValue(r.ext, ssa.TI32, x)
			}
			out = compat.Append(out, x)
		default:
			buf = s.cTemp(r, "cres")
			s.zero(buf, max(roundUp8(r.size), 8))
		}
		if buf != nil {
			offs := s.l.resultOffsets(&abiSig{results: resultParams(cs.results)})
			for i, T := range cs.results {
				s.storeTo(s.offPtr(buf, offs[i]), res[i], T)
			}
			if cs.sret {
				out = compat.Append(out, sretPtr) // System V returns the buffer's address
			} else {
				for k, t := range r.pieces {
					out = compat.Append(out, s.load(t, s.offPtr(buf, int64(8*k))))
				}
			}
		}
	}
	ret := s.b
	ret.Kind = ssa.BlockRet
	ret.SetControl(compat.Append([]*ssa.Value{s.mem()}, out...)...)
	s.b = nil
}

