		f.addIdent(v, m)
	}
	if v != nil && isGlobal(v) && f.storeAny.union(m) {
		// Other functions read package variables.
		f.changed = true
	}
	f.addVar(v, m)
}

func (f *closureFlow) addIdent(v *types2.Var, m bitset) {
	b := f.ident[v]
	if b.union(m) {
		f.ident[v] = b
		f.changed = true
	}
}

// isGlobal reports whether v is a package-level variable.
func isGlobal(v *types2.Var) bool {
	return v.Pkg() != nil && v.Parent() == v.Pkg().Scope()
}

// addressOf records that e's address is taken.
func (f *closureFlow) addressOf(e ast.Expr) {
	v, ind := f.root(e)
	if v != nil && !ind && !f.addressed[v] {
		f.addressed[v] = true
		f.changed = true
	}
}

func (f *closureFlow) visit(n ast.Node) bool {
	switch n := n.(type) {
	case *ast.AssignStmt:
		if len(n.Lhs) == len(n.Rhs) {
			for i, lhs := range n.Lhs {
				f.assign(lhs, f.expr(n.Rhs[i]))
			}
		} else if len(n.Rhs) == 1 {
			m := f.expr(n.Rhs[0])
			for _, lhs := range n.Lhs {
				f.assign(lhs, m)
			}
		}
	case *ast.OrStmt:
		// The values and err come from the call (language spec section
		// 11.27).
		m := f.expr(n.Call)
		for _, lhs := range n.Lhs {
			f.assign(lhs, m)
		}
		if v, ok := f.info.Implicits[n].(*types2.Var); ok {
			f.addVar(v, m)
		}
	case *ast.ValueSpec:
		if len(n.Names) == len(n.Values) {
			for i, id := range n.Names {
				f.assign(id, f.expr(n.Values[i]))
			}
		} else if len(n.Values) == 1 {
			m := f.expr(n.Values[0])
			for _, id := range n.Names {
				f.assign(id, m)
			}
		}
	case *ast.RangeStmt:
		x := f.expr(n.X)
		m := x.or(f.unknown()).or(f.pool)
		if _, ok := underlying(f.typeOf(n.X)).(*types2.Signature); ok {
			// The iterator yields what it captured (a parameter: anything
			// it holds), not itself, or, for a literal of this function,
			// what its body passes to yield.
			m = x.from(0, len(f.params)).or(f.unknown()).or(f.pool).or(f.state(x))
			if len(f.lits(x)) > 0 {
				m = m.or(f.litArgs)
			}
		}
		if n.Key != nil {
			f.assign(n.Key, m)
		}
		if n.Value != nil {
			f.assign(n.Value, m)
		}
		if _, ok := underlying(f.typeOf(n.X)).(*types2.Array); ok && n.Value != nil {
			f.addressOf(n.X)
		}
	case *ast.TypeSwitchStmt:
		var x ast.Expr
		switch a := n.Assign.(type) {
		case *ast.AssignStmt:
			x = a.Rhs[0].(*ast.TypeAssertExpr).X
		case *ast.ExprStmt:
			x = a.X.(*ast.TypeAssertExpr).X
		}
		m := f.expr(x)
		for _, c := range n.Body.List {
			if v, ok := f.info.Implicits[c].(*types2.Var); ok {
				f.addVar(v, m)
			}
		}
	case *ast.SendStmt:
		f.assign(&ast.StarExpr{X: n.Chan}, f.expr(n.Value))
	case *ast.TaskStmt:
		// The task runs the function with the arguments, which must
		// outlive this frame.
		m := f.expr(n.Call.Fun)
		for _, a := range n.Call.Args {
			m = m.or(f.expr(a))
		}
		f.start(m)
	case *ast.CallExpr:
		f.call(n)
	case *ast.UnaryExpr:
		if n.Op == token.AND {
			f.addressOf(n.X)
		}
	case *ast.SliceExpr:
		if _, ok := underlying(f.typeOf(n.X)).(*types2.Array); ok {
			f.addressOf(n.X)
		}
	case *ast.FuncLit:
		sig, _ := f.typeOf(n).(*types2.Signature)
		if sig != nil {
			for i := 0; i < sig.Params().Len(); i++ {
				if id := paramIdent(n, i); id != nil {
					if v, _ := f.info.Defs[id].(*types2.Var); v != nil && !f.litIn[n].empty() {
						// What a call passes is assigned to the parameter
						// itself: storing through it stores where that points.
						f.addIdent(v, f.litIn[n])
						f.addVar(v, f.litIn[n])
					}
				}
			}
		}
	}
	return true
}

// paramIdent returns the identifier of lit's i'th parameter, or nil.
func paramIdent(lit *ast.FuncLit, i int) *ast.Ident {
	for _, fld := range lit.Type.Params.List {
		if len(fld.Names) == 0 {
			if i == 0 {
				return nil
			}
			i--
			continue
		}
		if i < len(fld.Names) {
			return fld.Names[i]
		}
		i -= len(fld.Names)
	}
	return nil
}

// expr returns the origins of e's value. A value that refers to memory
// may see whatever was stored there through another pointer.
func (f *closureFlow) expr(e ast.Expr) bitset {
	m := f.expr1(e)
	if e != nil && !f.pool.empty() && f.l.refers(f.typeOf(e)) {
		if tv, ok := f.info.Types[e]; !ok || (!tv.IsType() && tv.Value.IsNil()) {
			m = m.or(f.pool)
		}
	}
	return m
}

func (f *closureFlow) expr1(e ast.Expr) bitset {
	if e == nil {
		return nil
	}
	if tv, ok := f.info.Types[e]; ok && (tv.IsType() || !tv.Value.IsNil()) {
		return nil
	}
	switch e := e.(type) {
	case *ast.CallExpr:
		m := f.call(e)
		if !f.l.carries(f.typeOf(e)) {
			return nil
		}
		if tv, ok := f.info.Types[e.Fun]; !ok || !tv.IsType() {
			m = m.or(f.unknown())
		}
		return m
	case *ast.KeyValueExpr:
		return f.expr(e.Key).or(f.expr(e.Value))
	}
	if !f.l.carries(f.typeOf(e)) {
		return nil
	}
	switch e := e.(type) {
	case *ast.ParenExpr:
		return f.expr(e.X)
	case *ast.Ident:
		switch obj := f.info.ObjectOf(e).(type) {
		case *types2.Var:
			return f.varOrigins(obj)
		case *types2.Func:
			return f.unknown()
		}
	case *ast.FuncLit:
		if len(litCaptures(f.info, e)) == 0 {
			return nil
		}
		// What the literal holds is only reached by calling it, which the
		// analysis follows (litResults).
		var m bitset
		m.add(f.source(e))
		return m
	case *ast.SelectorExpr:
		sel := f.info.Selections[e]
		if sel == nil {
			switch obj := f.info.Uses[e.Sel].(type) {
			case *types2.Var:
				return f.varOrigins(obj)
			case *types2.Func:
				return f.unknown()
			}
			return nil
		}
		switch sel.Kind() {
		case types2.FieldVal:
			m := f.expr(e.X)
			if sel.Indirect() || f.isPointer(e.X) {
				m = m.or(f.pool).or(f.unknown())
			}
			return m
		case types2.MethodVal:
			var m bitset
			i := f.source(e)
			m.add(i)
			x := f.expr(e.X)
			f.addSrcArgs(i, x)
			return m.or(x)
		case types2.MethodExpr:
			return f.unknown()
		}
	case *ast.IndexExpr:
		if _, ok := f.info.ObjectOf(identOf(ast.Unparen(e.X))).(*types2.Func); ok && identOf(ast.Unparen(e.X)) != nil {
			return f.unknown() // an instance of a generic function
		}
		m := f.expr(e.X)
		if _, arr := underlying(f.typeOf(e.X)).(*types2.Array); !arr {
			m = m.or(f.pool).or(f.unknown())
		}
		return m
	case *ast.IndexListExpr:
		return f.unknown()
	case *ast.SliceExpr:
		return f.expr(e.X).or(f.pool).or(f.unknown())
	case *ast.StarExpr:
		return f.expr(e.X).or(f.pool).or(f.unknown())
	case *ast.UnaryExpr:
		switch e.Op {
		case token.AND:
			return f.expr(e.X)
		case token.ARROW:
			return f.expr(e.X).or(f.pool).or(f.unknown())
		}
	case *ast.CompositeLit:
		var m bitset
		for _, x := range e.Elts {
			m.union(f.expr(x))
		}
		return m
	case *ast.TypeAssertExpr:
		return f.expr(e.X)
	}
	return nil
}

// litCaptures lists the variables lit uses that are declared in an
// enclosing function, in first-use order.
func litCaptures(info *types2.Info, lit *ast.FuncLit) []*types2.Var {
	var out []*types2.Var
	seen := map[*types2.Var]bool{}
	ast.Inspect(lit.Body, func(n ast.Node) bool {
		id, ok := n.(*ast.Ident)
		if !ok {
			return true
		}
		v, ok := info.Uses[id].(*types2.Var)
		if !ok || seen[v] || v.IsField() || v.Pkg() == nil || v.Parent() == v.Pkg().Scope() {
			return true
		}
		if v.Pos() >= lit.Pos() && v.Pos() < lit.End() {
			return true
		}
		seen[v] = true
		out = compat.Append(out, v)
		return true
	})
	return out
}

// call returns the origins of c's results and records what the callee may
// store.
func (f *closureFlow) call(c *ast.CallExpr) bitset {
	if tv, ok := f.info.Types[c.Fun]; ok && tv.IsType() {
		if len(c.Args) == 1 {
			return f.expr(c.Args[0])
		}
		return nil
	}
	var args []ast.Expr
	var recv ast.Expr
	fun := stripIndex(ast.Unparen(c.Fun))
	if se, ok := fun.(*ast.SelectorExpr); ok {
		if sel := f.info.Selections[se]; sel != nil && sel.Kind() == types2.MethodVal {
			recv = se.X
		}
	}
	if recv != nil {
		args = compat.Append(args, recv)
	}
	args = compat.Append(args, c.Args...)
	masks := compat.Make[bitset](len(args))
	var all bitset
	for i, a := range args {
		masks[i] = f.expr(a)
		all.union(masks[i])
	}
	if f.litArgs.union(all) {
		f.changed = true
	}
	var cm bitset // the callee's origins, for a call through a func value
	if recv == nil {
		if tv, ok := f.info.Types[c.Fun]; !ok || tv.Value.IsNil() {
			if _, builtin := f.info.ObjectOf(identOf(fun)).(*types2.Builtin); !builtin || identOf(fun) == nil {
				cm = f.expr(c.Fun)
			}
		}
	}
	// Built-in functions.
	if id := identOf(fun); id != nil {
		if b, ok := f.info.ObjectOf(id).(*types2.Builtin); ok {
			switch b.Name() {
			case "copy":
				if len(c.Args) == 2 {
					f.assign(&ast.StarExpr{X: c.Args[0]}, masks[1])
				}
				return nil
			}
			return all
		}
	}

	var ret, store bitset // store: through any argument that can reach memory
	argStore := compat.Make[bitset](len(args))
	var anyStore bitset // through pointers the arguments do not reach
	builds := true      // whether the callee may build closures in a region
	keepsOwn := false   // and keep them anywhere
	if g, targs := f.callee(c); g != nil {
		sum := f.l.closureSummary(g, targs)
		builds = sum.all || sum.builds
		keepsOwn = sum.keepsOwn
		if sum.all {
			r := f.callFuncs(all, all.or(f.unknown()))
			ret = all.or(r).or(f.state(all))
			store = ret
			f.storeState(all, ret)
		} else {
			sig := g.Type().(*types2.Signature)
			nrecv := 0
			if sig.Recv() != nil {
				nrecv = 1
			}
			gp := nrecv + sig.Params().Len()
			// param maps each argument to its parameter, or -1 for the
			// results of f(g()), which fill every parameter.
			param := func(i int) int {
				if len(c.Args) == 1 && i == len(args)-1 {
					if _, multi := f.typeOf(c.Args[0]).(*types2.Tuple); multi {
						return -1
					}
				}
				p := i
				if recv == nil {
					p += nrecv
				}
				return min(p, gp-1)
			}
			of := func(p int) bitset {
				var m bitset
				for i := range args {
					if q := param(i); q == p || q < 0 {
						m.union(masks[i])
					}
				}
				return m
			}
			for i := range args {
				p := param(i)
				if p < 0 && !sum.starts.empty() || p >= 0 && sum.starts.has(p) {
					f.start(masks[i])
				}
				if p < 0 {
					r := f.callFuncs(masks[i], all.or(f.unknown()))
					ret.union(masks[i].or(r))
					store.union(masks[i].or(r).or(f.state(masks[i])))
					continue
				}
				if sum.ret.has(p) {
					ret.union(masks[i])
				}
				if sum.storeAny.has(p) {
					anyStore.union(masks[i])
				}
				for _, q := range sum.store[p].members() {
					argStore[i].union(of(q))
				}
				if sum.calls.has(p) {
					// What the callee does with what calling it returns
					// or passes on is the parameter's, applied above.
					in := f.unknown()
					for _, q := range sum.callArgs[p].members() {
						in.union(of(q))
					}
					r := f.callFuncs(masks[i], in)
					ret.union(r)
					store.union(r.or(f.kept(masks[i])))
					f.storeState(masks[i], in)
				}
			}
		}
	} else if lits := f.knownLits(c.Fun, recv); lits != nil {
		// Literals of this function: the analysis sees what their bodies
		// store, and their parameters receive these arguments.
		for _, lit := range lits {
			f.addLitIn(lit, all)
			ret.union(f.litResults(lit))
		}
	} else {
		// Unknown code: it may return or store anything passed to it, and
		// call any func value passed to it with that and with what the
		// callee captured, which it may also return. What it stores of
		// what the callee captured is kept. A parameter called stands for
		// what it returns and passes on, for the summary.
		if recv != nil {
			cm = masks[0]
		}
		st := f.state(cm.or(all))
		fs := all.or(cm).or(st)
		r := f.callFuncs(fs, all.or(f.unknown()))
		back := st.or(cm.from(0, len(f.params)))
		for _, lit := range f.lits(fs) {
			f.addLitIn(lit, back)
		}
		ret = all.or(back).or(r)
		store = all.or(f.state(all)).or(f.kept(cm)).or(r)
		f.storeState(cm.or(all), store)
	}
	if sig, ok := underlying(f.typeOf(c.Fun)).(*types2.Signature); ok && regionSig(sig) && builds {
		// The callee builds the closures it returns in a region this
		// frame provides. They are in the result only if its type can hold
		// a func value (a types2.Type cannot).
		if f.l.carries(f.typeOf(c)) {
			ret.add(f.source(c))
		}
		f.noteSrcArgs(f.source(c), c, all, cm)
		if keepsOwn {
			var b bitset
			b.add(f.source(c))
			f.keepAny(b)
		}
	}
	f.keepAny(anyStore)
	for i, a := range args {
		m := argStore[i].or(store)
		if m.empty() {
			continue
		}
		if i == 0 && recv != nil && !f.isPointer(recv) {
			f.assign(recv, m) // a pointer method changes the receiver itself
		} else if f.l.refers(f.typeOf(a)) {
			// Through a pointer, slice, map, channel or interface; what a
			// func value captured is changed by calling it (storeState).
			f.assign(&ast.StarExpr{X: a}, m)
		}
	}
	f.keepAny(store)
	return ret
}

// noteSrcArgs records the origins of what the call c, whose closures are the
// origin i, was given: its arguments and receiver (all), the func value it
// calls (cm) and what its function selector's operand holds. The closures
// capture them. They are found when the call is analysed and kept, since
// evaluating the arguments again for each use of the origin took, for calls
// nested in each other, time that grows with every level, and for calls that
// refer to each other through variables, forever.
func (f *closureFlow) noteSrcArgs(i int, c *ast.CallExpr, all, cm bitset) {
	b := all.or(cm)
	if se, ok := stripIndex(ast.Unparen(c.Fun)).(*ast.SelectorExpr); ok && f.info.Selections[se] != nil {
		b.union(f.expr(se.X))
	}
	f.addSrcArgs(i, b)
}

// addSrcArgs adds b to what the origin i, a call's closures or a method
// value's record, holds.
func (f *closureFlow) addSrcArgs(i int, b bitset) {
	have := f.srcArgs[i]
	if have.union(b) {
		f.srcArgs[i] = have
		f.changed = true
	}
}

// keepAny records that values with origins m may be stored through any
// pointer: in the pool, and in the summary.
func (f *closureFlow) keepAny(m bitset) {
	f.addPool(m)
	if f.storeAny.union(m) {
		f.changed = true
	}
}

// callFuncs records that the func values with origins m may be called with
// arguments with origins in, and returns the origins of what they may
// return: what the function's own literals among them return (the others
// are covered by state).
func (f *closureFlow) callFuncs(m, in bitset) bitset {
	var r bitset
	for _, lit := range f.lits(m) {
		f.addLitIn(lit, in)
		r.union(f.litResults(lit))
	}
	for _, j := range m.from(0, len(f.params)).members() {
		b := f.callArgs[j]
		if b.union(in.from(0, len(f.params))) {
			f.callArgs[j] = b
			f.changed = true
		}
	}
	return r
}

// start records that a task may be started with the func values with
// origins m.
func (f *closureFlow) start(m bitset) {
	if f.started.union(m) {
		f.changed = true
	}
}

// addLitIn records that lit's parameters may receive values with origins m.
func (f *closureFlow) addLitIn(lit *ast.FuncLit, m bitset) {
	b := f.litIn[lit]
	if b.union(m) {
		f.litIn[lit] = b
		f.changed = true
	}
}

// state returns the origins of what calling a func value with origins m
// may return, or pass to the func values it is given: what it captured.
// The function's own literals are left out, since the analysis sees their
// bodies, and so are its parameters and unknown functions, whose captured
// variables are in other frames; the parameters are recorded as called, for
// the summary.
func (f *closureFlow) state(m bitset) bitset { return f.captured(m, false) }

// kept returns the origins of what calling a func value with origins m may
// store where this function cannot see: state, less the arguments of the
// calls whose closures are among m. What a declared function's closures do
// with its parameters is in its summary, which the call that made them
// applied to the arguments; any other call already kept its arguments
// anywhere. What calls of the closures stored in them is still kept.
func (f *closureFlow) kept(m bitset) bitset { return f.captured(m, true) }

func (f *closureFlow) captured(m bitset, kept bool) bitset {
	if f.called.union(m.from(0, len(f.params))) {
		f.changed = true
	}
	var out bitset
	for _, i := range m.members() {
		if i < f.firstSrc() {
			continue
		}
		switch f.src[i-f.firstSrc()].(type) {
		case *ast.SelectorExpr:
			// A method value's copy of its receiver.
			out.union(f.srcArgs[i])
			out.union(f.srcState[i])
		case *ast.CallExpr:
			// The closures a call returns capture its arguments, and what
			// calls of them stored. Calling them may return the closures
			// in their region too.
			out.union(f.srcState[i])
			if kept {
				continue
			}
			out.add(i)
			out.union(f.srcArgs[i])
		}
	}
	return out
}

// storeState records that calling, or passing to unknown code, the func
// values with origins m may store values with origins vals in what they
// captured: the records of method values and of calls' closures. A
// literal's captured variables are the analysis' own.
func (f *closureFlow) storeState(m, vals bitset) {
	for _, i := range m.from(f.firstSrc(), -1).members() {
		if _, lit := f.src[i-f.firstSrc()].(*ast.FuncLit); lit {
			continue
		}
		b := f.srcState[i]
		if b.union(vals) {
			f.srcState[i] = b
			f.changed = true
		}
	}
}

// lits returns the function literals of this function among the origins m.
func (f *closureFlow) lits(m bitset) []*ast.FuncLit {
	var out []*ast.FuncLit
	for _, i := range m.members() {
		if i >= f.firstSrc() {
			if lit, ok := f.src[i-f.firstSrc()].(*ast.FuncLit); ok {
				out = compat.Append(out, lit)
			}
		}
	}
	return out
}

// knownLits returns the function literals of this function that fun, the
// callee of a call with receiver recv, may be, or nil if it may be anything
// else.
func (f *closureFlow) knownLits(fun, recv ast.Expr) []*ast.FuncLit {
	if recv != nil {
		return nil
	}
	if lit, ok := ast.Unparen(fun).(*ast.FuncLit); ok {
		return compat.Clone([]*ast.FuncLit{lit})
	}
	m := f.expr(fun)
	if m.empty() {
		return nil
	}
	var lits []*ast.FuncLit
	for _, i := range m.members() {
		if i < f.firstSrc() {
			return nil
		}
		lit, ok := f.src[i-f.firstSrc()].(*ast.FuncLit)
		if !ok {
			return nil
		}
		lits = compat.Append(lits, lit)
	}
	return lits
}

// litResults returns the origins of what lit, a literal of this function,
// returns.
func (f *closureFlow) litResults(lit *ast.FuncLit) bitset {
	var m bitset
	sig, _ := f.typeOf(lit).(*types2.Signature)
	if sig == nil || sig.Results().Len() == 0 {
		return nil
	}
	if f.resultsBusy[lit] {
		// The literal returns a call of itself, or of one that calls it:
		// what it returns is being found; the passes over the function
		// repeat until what is found stops growing.
		return nil
	}
	if f.resultsBusy == nil {
		f.resultsBusy = map[*ast.FuncLit]bool{}
	}
	f.resultsBusy[lit] = true
	defer delete(f.resultsBusy, lit)
	named := hasDefer(lit.Body)
	ast.Inspect(lit.Body, func(n ast.Node) bool {
		switch n := n.(type) {
		case *ast.FuncLit:
			return false
		case *ast.ReturnStmt:
			for _, e := range n.Results {
				m.union(f.expr(e))
			}
			named = named || len(n.Results) == 0
		case *ast.OrStmt:
			// A short form of return in the clause may return err
			// (language spec section 11.27).
			if r, ok := n.Clause.(*ast.ReturnStmt); ok && len(r.Results) == 0 {
				if v, ok := f.info.Implicits[n].(*types2.Var); ok {
					m.union(f.varOrigins(v))
				}
			}
		}
		return true
	})
	if named {
		for i := 0; i < sig.Results().Len(); i++ {
			m.union(f.varOrigins(f.litResultVar(lit, i)))
		}
	}
	return m
}

// litResultVar returns lit's i'th named result, or nil.
func (f *closureFlow) litResultVar(lit *ast.FuncLit, i int) *types2.Var {
	if lit.Type.Results == nil {
		return nil
	}
	for _, fld := range lit.Type.Results.List {
		if i < len(fld.Names) {
			v, _ := f.info.Defs[fld.Names[i]].(*types2.Var)
			return v
		}
		i -= len(fld.Names)
	}
	return nil
}

// stripIndex returns the function that fun instantiates, or fun.
func stripIndex(fun ast.Expr) ast.Expr {
	switch ix := fun.(type) {
	case *ast.IndexExpr:
		return ast.Unparen(ix.X)
	case *ast.IndexListExpr:
		return ast.Unparen(ix.X)
	}
	return fun
}

// callee returns the declared function or concrete method c calls, with
// its type arguments in this instance, or nil.
func (f *closureFlow) callee(c *ast.CallExpr) (*types2.Func, []types2.Type) {
	g := calledFunc(f.info, c)
	if g == nil {
		return nil, nil
	}
	fun := stripIndex(ast.Unparen(c.Fun))
	if se, ok := fun.(*ast.SelectorExpr); ok && f.info.Selections[se] != nil {
		return g, f.ts.methodTypeArgs(g, se, f.info.TypeOf(se.X))
	}
	id := identOf(fun)
	if id == nil {
		return g, nil
	}
	return g, f.ts.instanceArgs(id)
}

// closureSummary returns what g, instantiated with targs, does with its
// parameters.
//
// Summaries of functions that call each other depend on one another. A
// function is analysed again until its summary stops growing, and a summary
// computed from one still being computed (further out on the stack, or the
// function's own) is tentative: it stays valid for the callers that are
// themselves being computed, and is final once the outermost of them
// finishes. Whenever any summary grows, flowVersion advances; a tentative
// summary computed at an earlier version is analysed once more, once, when a
// function being computed reads it, so a group of n mutually recursive
// functions costs a few analyses of each, not a number that grows with the
// depth of the calls among them.
func (l *Lowerer) closureSummary(g *types2.Func, targs []types2.Type) *flowSummary {
	key := funcSymName(g, targs)
	if s := l.flowSums[key]; s != nil {
		if s.depth >= 0 {
			l.flowMin = min(l.flowMin, s.depth)
			if !s.running && s.version != l.flowVersion {
				l.closureAgain(s, key)
			}
		}
		return s
	}
	d := l.decls[g.Origin()]
	if d == nil || d.decl.Body == nil {
		s := pu.New(flowSummary{all: true, depth: -1})
		l.flowSums[key] = s
		return s
	}
	depth := len(l.flowStack)
	s := pu.New(flowSummary{depth: depth, fn: g, targs: targs, store: map[int]bitset{}, callArgs: map[int]bitset{}})
	l.flowSums[key] = s
	if scoped.StartsTaskWithFunc(g) {
		// The runtime's and the library's task starts (spec section 12.12):
		// every func parameter starts a task.
		sig := g.Type().(*types2.Signature)
		for i := 0; i < sig.Params().Len(); i++ {
			if _, ok := sig.Params().At(i).Type().Underlying().(*types2.Signature); ok {
				s.starts.add(i)
			}
		}
	}
	l.flowStack = compat.Append(l.flowStack, key)
	s.running = true
	outer := l.flowMin
	mark := len(l.flowTent)
	low := depth
	for {
		// Recursive calls see the summary as it is computed, starting
		// empty, and the function is analysed again until a round changes
		// no summary at all.
		version := l.flowVersion
		l.flowMin = depth + 1
		s.version = version
		l.analyzeFlow(s)
		low = l.flowMin
		if l.flowVersion == version || low > depth {
			break
		}
	}
	s.running = false
	l.flowStack = l.flowStack[:depth]
	if low < depth {
		// Depends on a summary still being computed further out.
		s.depth = low
		l.flowTent = compat.Append(l.flowTent, key)
	} else {
		s.depth = -1
		for _, k := range l.flowTent[mark:] {
			if t := l.flowSums[k]; t != nil {
				t.depth = -1
			}
		}
		l.flowTent = l.flowTent[:mark]
	}
	l.flowMin = min(outer, low)
	return s
}

// closureAgain analyses the tentative summary s once more, because some
// summary has grown since it was computed.
func (l *Lowerer) closureAgain(s *flowSummary, key string) {
	pos := len(l.flowStack)
	own := s.depth
	l.flowStack = compat.Append(l.flowStack, key)
	s.running = true
	s.depth = pos
	outer := l.flowMin
	l.flowMin = pos + 1
	s.version = l.flowVersion
	l.analyzeFlow(s)
	low := l.flowMin
	s.running = false
	l.flowStack = l.flowStack[:pos]
	s.depth = min(low, own)
	l.flowMin = min(outer, s.depth)
}

// analyzeFlow analyses the body of s's function once and merges the result
// into s, advancing flowVersion if s grew.
func (l *Lowerer) analyzeFlow(s *flowSummary) {
	d := l.decls[s.fn.Origin()]
	var tmap *typeMap
	if len(s.targs) > 0 {
		tmap = newTypeMap(l, d.obj, s.targs)
	}
	f := newClosureFlow(l, d.pkg.Info, tmap, d.obj.Type().(*types2.Signature), d.decl.Body)
	f.run()
	if s.merge(f) {
		l.flowVersion++
	}
}

// merge adds what the analysis f found to s and reports whether s grew.
func (s *flowSummary) merge(f *closureFlow) bool {
	np := len(f.params)
	esc := f.escaping()
	grew := s.ret.union(esc.from(0, np))
	if !s.builds && !esc.from(f.firstSrc(), -1).empty() {
		s.builds = true
		grew = true
	}
	for j, m := range f.storeTo {
		b := s.store[j]
		if b.union(m.from(0, np)) {
			s.store[j] = b
			grew = true
		}
	}
	// A method value that code outside may call passes its receiver to a
	// method this analysis does not see, which may keep it anywhere.
	anyStore := f.storeAny
	for _, i := range f.external().from(f.firstSrc(), -1).members() {
		if _, ok := f.src[i-f.firstSrc()].(*ast.SelectorExpr); ok {
			anyStore = anyStore.or(f.srcArgs[i]).or(f.srcState[i])
		}
	}
	grew = s.storeAny.union(anyStore.from(0, np)) || grew
	// The closures it builds in its caller's region, and what they hold,
	// kept where the caller cannot see.
	if !s.keepsOwn {
		stored := anyStore
		for _, m := range f.storeTo {
			stored = stored.or(m)
		}
		for _, i := range esc.from(f.firstSrc(), -1).members() {
			if stored.has(i) {
				s.keepsOwn = true
				grew = true
				break
			}
		}
	}
	grew = s.calls.union(f.called.from(0, np)) || grew
	grew = s.starts.union(f.started.from(0, np)) || grew
	for j, m := range f.callArgs {
		b := s.callArgs[j]
		if b.union(m.from(0, np)) {
			s.callArgs[j] = b
			grew = true
		}
	}
	return grew
}

// escaping returns the origins of what the function may return, with
// what the closure records among them hold: the variables a literal
// captures, the receiver a method value copies.
func (f *closureFlow) escaping() bitset { return f.closeOver(f.resultOrigins()) }

// resultOrigins returns the origins of what the function may return.
func (f *closureFlow) resultOrigins() bitset {
	var m bitset
	for _, r := range f.returns() {
		for _, x := range f.returned(r) {
			m.union(x)
		}
	}
	return m
}

// closeOver adds to m the origins of what the closure records in m hold.
func (f *closureFlow) closeOver(m bitset) bitset {
	m = m.or(nil)
	done := map[int]bool{}
	for {
		grew := false
		for _, i := range m.from(f.firstSrc(), -1).members() {
			if done[i] {
				continue
			}
			done[i] = true
			switch n := f.src[i-f.firstSrc()].(type) {
			case *ast.FuncLit:
				for _, v := range litCaptures(f.info, n) {
					grew = m.union(f.varOrigins(v)) || grew
				}
			case *ast.SelectorExpr:
				grew = m.union(f.srcArgs[i]) || grew
				grew = m.union(f.srcState[i]) || grew
			case *ast.CallExpr:
				grew = m.union(f.srcState[i]) || grew
			}
		}
		if !grew {
			return m
		}
	}
}

// returns lists the function's own return statements, leaving out those
// of nested function literals.
func (f *closureFlow) returns() []*ast.ReturnStmt {
	var out []*ast.ReturnStmt
	ast.Inspect(f.body, func(n ast.Node) bool {
		switch n := n.(type) {
		case *ast.FuncLit:
			return false
		case *ast.ReturnStmt:
			out = compat.Append(out, n)
		}
		return true
	})
	return out
}

// returned returns the origins of each value r returns. A bare return
// returns the named results; with a deferred call, which may assign to
// them, every return does.
func (f *closureFlow) returned(r *ast.ReturnStmt) []bitset {
	var out []bitset
	if st := f.orReturnOf(r); st != nil {
		// A short form of return in an or clause (language spec section
		// 11.27): the last result is err or E, the others are zero or
		// the named results.
		if form := types2.OrReturnForm(f.results, r, f.info.Types); form != types2.OrReturnPlain {
			n := f.results.Len()
			for i := 0; i < n-1; i++ {
				out = compat.Append(out, f.varOrigins(f.results.At(i)))
			}
			var last bitset
			if form == types2.OrReturnExpr {
				last = f.expr(r.Results[0])
			} else if v, ok := f.info.Implicits[st].(*types2.Var); ok {
				last = f.varOrigins(v)
			}
			return compat.Append(out, last)
		}
	}
	if len(r.Results) == 0 || hasDefer(f.body) {
		for i := 0; i < f.results.Len(); i++ {
			out = compat.Append(out, f.varOrigins(f.results.At(i)))
		}
	}
	for _, e := range r.Results {
		out = compat.Append(out, f.expr(e))
	}
	return out
}

// orReturnOf returns the or statement whose whole clause is r, or nil.
func (f *closureFlow) orReturnOf(r *ast.ReturnStmt) *ast.OrStmt {
	var out *ast.OrStmt
	ast.Inspect(f.body, func(n ast.Node) bool {
		if st, ok := n.(*ast.OrStmt); ok && st.Clause == r {
			out = st
		}
		return out == nil
	})
	return out
}

// ----------------------------------------------------------------------------
// Reporting

// planClosures decides, before s's function is lowered, where the closure
// records it may return are built: in the region its caller provides, when
// it takes one (regions.go). It reports the records that cannot be built
// there and so cannot outlive this frame (E3100), and the closures of calls
// in a loop that are kept past the iteration (E3101).
func (s *fnState) planClosures() {
	l, job := s.l, s.job
	var body *ast.BlockStmt
	var name string
	var sig *types2.Signature
	switch {
	case job.pkg == nil:
		return
	case job.decl != nil:
		body, name = job.decl.Body, job.decl.Name.Name
		sig = job.pkg.Info.Defs[job.decl.Name].Type().(*types2.Signature)
	case job.lit != nil:
		body, name = job.lit.Body, compat.Concat("the function literal at ", l.shortPos(job.lit.Pos()))
		sig = job.pkg.Info.TypeOf(job.lit).(*types2.Signature)
	}
	if body == nil {
		return
	}
	f := newClosureFlow(l, job.pkg.Info, job.tmap, sig, body)
	f.run()
	f.findForeign()
	s.checkLoopRegions(f)
	if job.sig.Results().Len() == 0 {
		return
	}
	region := s.abi.region
	for _, i := range f.escaping().from(f.firstSrc(), -1).members() {
		n := f.src[i-f.firstSrc()]
		if !region || !f.ownFrame(n.Pos()) {
			continue
		}
		switch n := n.(type) {
		case *ast.FuncLit:
			s.regionNodes[n] = true
			for _, v := range litCaptures(f.info, n) {
				if s.ownVar(f, v) {
					s.regionVars[v] = true
				}
			}
		case *ast.SelectorExpr:
			s.regionNodes[n] = true
		case *ast.CallExpr:
			s.regionCalls[n] = true
		}
	}
	for _, r := range f.returns() {
		ms := f.returned(r)
		named := len(ms) - len(r.Results)
		for i, m := range ms {
			// The records that cannot be built in a region. A call's
			// closures are only a problem if the callee builds any: that
			// is known once every function is lowered (finishRegions).
			src := -1
			var calls []int
			for _, j := range f.closeOver(m).from(f.firstSrc(), -1).members() {
				n := f.src[j-f.firstSrc()]
				if region && f.ownFrame(n.Pos()) {
					continue
				}
				if _, ok := n.(*ast.CallExpr); ok {
					calls = compat.AppendPlain(calls, j)
					continue
				}
				src = j
				break
			}
			if src < 0 && calls == nil {
				continue
			}
			var e ast.Expr
			var what string
			pos := r.Pos()
			if i >= named {
				e = r.Results[i-named]
				what, pos = shortExpr(e), e.Pos()
			} else {
				what = f.results.At(i).Name()
			}
			if l.flowReported[pos] {
				break
			}
			l.flowReported[pos] = true
			if src >= 0 {
				l.report(pos, f.diagnose(e, what, f.src[src-f.firstSrc()], name, job, region))
				break
			}
			var cands []regionCand
			for _, j := range calls {
				c := f.src[j-f.firstSrc()].(*ast.CallExpr)
				cands = compat.Append(cands, regionCand{key: f.callKey(c), pos: pos, d: f.diagnose(e, what, c, name, job, region)})
			}
			l.regionPending = compat.Append(l.regionPending, cands)
			break
		}
	}
}

// ownVar reports whether v is declared in the frame of s's function: in its
// signature or body, outside nested literals and range-over-func bodies.
func (s *fnState) ownVar(f *closureFlow, v *types2.Var) bool {
	var lo, hi token.Pos
	if s.job.decl != nil {
		lo, hi = s.job.decl.Pos(), s.job.decl.End()
	} else {
		lo, hi = s.job.lit.Pos(), s.job.lit.End()
	}
	return v.Pos() >= lo && v.Pos() < hi && f.ownFrame(v.Pos())
}

// A loopSpan is a loop of a function body. An iteration runs the code from
// lo to hi, and makes the variables declared from vlo to hi anew.
type loopSpan struct {
	lo, hi, vlo token.Pos
	forStmt     token.Pos // a for statement, whose init statement's variables carry their value to the next iteration
	label       string    // a loop that a goto back to this label makes
	gotoAt      token.Pos // and the goto
}

// loopSpans lists the loops of body, outside function literals nested in
// it: for and range statements, and the loops a goto makes by jumping back
// to a label before it. lits lists the literals.
func loopSpans(body ast.Node) (loops, lits []loopSpan) {
	labels := map[string]token.Pos{}
	ast.Inspect(body, func(n ast.Node) bool {
		switch n := n.(type) {
		case *ast.FuncLit:
			lits = compat.Append(lits, loopSpan{lo: n.Pos(), hi: n.End(), vlo: n.Pos()})
			return false
		case *ast.ForStmt:
			// An iteration runs the condition, the body and the post
			// statement. The init statement's variables are per iteration
			// as in Go, but each starts with the value the previous
			// iteration's had.
			lo := n.Body.Pos()
			if n.Post != nil {
				lo = n.Post.Pos()
			}
			if n.Cond != nil {
				lo = n.Cond.Pos()
			}
			loops = compat.Append(loops, loopSpan{lo: lo, hi: n.Body.End(), vlo: lo, forStmt: n.Pos()})
		case *ast.RangeStmt:
			loops = compat.Append(loops, loopSpan{lo: n.Body.Pos(), hi: n.Body.End(), vlo: n.Pos()})
		case *ast.LabeledStmt:
			labels[n.Label.Name] = n.Pos()
		case *ast.BranchStmt:
			// Inspect visits in source order, so a label already seen
			// is before the goto.
			if lp, ok := labels[identName(n.Label)]; ok && n.Tok == token.GOTO {
				loops = compat.Append(loops, loopSpan{lo: lp, hi: n.End(), vlo: lp, label: n.Label.Name, gotoAt: n.Pos()})
			}
		}
		return true
	})
	return loops, lits
}

func identName(id *ast.Ident) string {
	if id == nil {
		return ""
	}
	return id.Name
}

// checkLoopRegions reports the closures of calls in a loop that are kept
// past the iteration: the call's region is reused by the next one. Passed
// back to the same call, such a closure would be read through after the
// call refilled its region, which is why nothing a call builds in its
// region may reach the call's next run.
func (s *fnState) checkLoopRegions(f *closureFlow) {
	loops, lits := loopSpans(f.body)
	in := func(p, lo, hi token.Pos) bool { return p >= lo && p < hi }
	inLit := func(p token.Pos) bool {
		for _, sp := range lits {
			if in(p, sp.lo, sp.hi) {
				return true
			}
		}
		return false
	}
	for k, n := range f.src {
		c, ok := n.(*ast.CallExpr)
		if !ok || inLit(c.Pos()) {
			continue
		}
		// A variable keeps the closure from one run of the call to the
		// next unless every loop the call is in declares it anew.
		var around []*loopSpan
		for i := range loops {
			if in(c.Pos(), loops[i].lo, loops[i].hi) {
				around = compat.Append(around, &loops[i])
			}
		}
		if around == nil {
			continue
		}
		bit := f.firstSrc() + k
		var kept *types2.Var
		var loop *loopSpan
		for v, m := range f.vars {
			if !m.has(bit) || v.Name() == "_" || inLit(v.Pos()) || kept != nil && v.Pos() >= kept.Pos() {
				continue
			}
			for _, sp := range around {
				if !in(v.Pos(), sp.vlo, sp.hi) {
					kept, loop = v, sp
					break
				}
			}
		}
		if loop == nil {
			loop = around[len(around)-1]
			for _, sp := range around {
				if sp.lo > loop.lo {
					loop = sp
				}
			}
		}
		var where string
		switch {
		case kept != nil && loop.forStmt.IsValid() && kept.Pos() >= loop.forStmt && kept.Pos() < loop.lo:
			where = compat.Sprintfb("%s, a variable of the for statement (%s), which passes its value on to the next iteration", compat.ArgS(kept.Name()), compat.ArgS(s.l.shortPos(kept.Pos())))
		case kept != nil:
			where = compat.Sprintfb("%s, declared outside the loop (%s)", compat.ArgS(kept.Name()), compat.ArgS(s.l.shortPos(kept.Pos())))
		case f.pool.has(bit):
			where = "memory reached through a pointer"
		default:
			continue
		}
		if s.l.flowReported[c.Pos()] {
			continue
		}
		s.l.flowReported[c.Pos()] = true
		call := shortExpr(c)
		what := "this iteration of the loop"
		text := ""
		if loop.label != "" {
			what = compat.Concat("this run of the loop that goto ", loop.label, " makes")
			text = compat.Sprintfb("The goto at %s jumps back to the label %s, before the call, which makes a loop. ", compat.ArgS(s.l.shortPos(loop.gotoAt)), compat.ArgS(loop.label))
		}
		text = compat.Concat(text, compat.Sprintfb("A function that returns a closure builds it in a region its caller provides (spec section 11.5). The region of a call in a loop is part of this frame, and the call uses the same region on every iteration, so the closure %s returns on one iteration is overwritten on the next. Keeping it past the iteration, in %s, would leave it changing under you.", compat.ArgS(call), compat.ArgS(where)))
		fix := "\nUse the closure within the iteration, or declare the variable that holds it inside the loop."
		for _, a := range c.Args {
			if f.expr(a).has(bit) {
				// it = Filter(it, f): each closure would hold the one
				// before, a chain as long as the loop runs.
				text = compat.Concat(text, compat.Sprintfb(" Here the closure is passed back to %s, so each one would hold the one the call made before, in the region the call is about to refill: the chain grows with every iteration, and no region of fixed size can hold it.", compat.ArgS(shortExpr(c.Fun))))
				fix = "\nCompose a fixed number of closures, or keep what each step needs in a slice and return one closure that applies every step."
				break
			}
		}
		// Reported only if the callee builds closures (finishRegions).
		s.l.regionPending = compat.Append(s.l.regionPending, compat.Clone([]regionCand{{key: f.callKey(c), pos: c.Pos(), d: pu.New(diag.Diagnostic{
			Code: diag.ClosureRegionLoop,
			Msg:  compat.Sprintfb("cannot keep the closure %s returns past %s: it is stored in %s", compat.ArgS(call), compat.ArgS(what), compat.ArgS(where)),
			Text: compat.Concat(text, fix),
		})}}))
	}
}

// callKey names the region a call c needs (regionKey).
func (f *closureFlow) callKey(c *ast.CallExpr) regionKey {
	if g, targs := f.callee(c); g != nil {
		return regionKey{name: funcSymName(g, targs)}
	}
	sig, _ := underlying(f.typeOf(c.Fun)).(*types2.Signature)
	if sig == nil {
		return regionKey{}
	}
	return regionKey{sig: f.l.sigKey(sig)}
}

// diagnose explains returning what (the expression e, or a named result
// when e is nil), which holds the closure record src, made in the frame of
// the function called name or in a function nested in it. region says
// whether that function takes a region its callers provide.
func (f *closureFlow) diagnose(e ast.Expr, what string, src ast.Node, name string, job *funcJob, region bool) *diag.Diagnostic {
	l := f.l
	direct := e != nil && ast.Unparen(e) == src
	d := pu.New(diag.Diagnostic{Code: diag.ClosureReturned})
	maker := name
	if region {
		maker = f.container(src)
	}
	why := compat.Sprintfb("\n%s's results can hold the closure only through a pointer, so its callers provide no region to build it in (spec section 11.5). Return the closure itself, an interface holding it, or a struct or array holding it, instead.", compat.ArgS(name))
	if region {
		why = compat.Sprintfb("\n%s builds the closures it returns in a region its caller provides (spec section 11.5), but this one is made in %s, which is a function of its own. Make it in %s itself.", compat.ArgS(name), compat.ArgS(maker), compat.ArgS(name))
	}
	switch src := src.(type) {
	case *ast.FuncLit:
		v := litCaptures(f.info, src)[0]
		owner := l.varOwner(v, job, name)
		if direct {
			d.Msg = compat.Sprintfb("cannot return the function literal: it uses %s, a local variable of %s", compat.ArgS(v.Name()), compat.ArgS(owner))
		} else {
			d.Msg = compat.Sprintfb("cannot return %s: it holds the function literal at %s, which uses %s, a local variable of %s", compat.ArgS(what), compat.ArgS(l.shortPos(src.Pos())), compat.ArgS(v.Name()), compat.ArgS(owner))
		}
		d.Text = compat.Concat(compat.Sprintfb("A function literal that uses variables of the functions around it is a closure record, holding the code to run and where each variable is, in the frame of the function that makes it: here %s. That frame is reclaimed when %s returns, and the record with it.", compat.ArgS(maker), compat.ArgS(maker)), why)
		d.Fix = pu.New(diag.Fix{
			Intro: "Return a value that carries its own state instead, such as a struct with a method",
			Code:  compat.Sprintfb("type state struct {\n\t%s %s\n}\n\nfunc (s *state) call() {\n\t... s.%s ...\n}", compat.ArgS(v.Name()), compat.ArgS(types2.TypeString(v.Type(), types2.RelativeTo(v.Pkg()))), compat.ArgS(v.Name())),
		})
	case *ast.SelectorExpr:
		mv := types2.ExprString(src)
		if direct {
			d.Msg = compat.Sprintfb("cannot return the method value %s: its closure record is in %s's frame", compat.ArgS(mv), compat.ArgS(maker))
		} else {
			d.Msg = compat.Sprintfb("cannot return %s: it holds the method value %s (%s), whose closure record is in %s's frame", compat.ArgS(what), compat.ArgS(mv), compat.ArgS(l.shortPos(src.Pos())), compat.ArgS(maker))
		}
		d.Text = compat.Concat(compat.Sprintfb("A method value such as %s is a closure record, holding the method to call and a copy of the receiver, in the frame of the function that makes it: here %s. That frame is reclaimed when %s returns, and the record with it.", compat.ArgS(mv), compat.ArgS(maker), compat.ArgS(maker)), why)
		sel := f.info.Selections[src]
		recv := types2.TypeString(sel.Obj().Type().(*types2.Signature).Recv().Type(), types2.RelativeTo(sel.Obj().Pkg()))
		d.Fix = pu.New(diag.Fix{
			Intro: "Return the receiver and let the caller call the method, or return a method expression, which takes the receiver as its first argument",
			Code:  compat.Sprintfb("m := (%s).%s // m(x, ...) calls x.%s(...)", compat.ArgS(recv), compat.ArgS(sel.Obj().Name()), compat.ArgS(sel.Obj().Name())),
		})
	case *ast.CallExpr:
		call := shortExpr(src)
		if direct {
			d.Msg = compat.Sprintfb("cannot return %s: its closures are built in %s's frame", compat.ArgS(call), compat.ArgS(maker))
		} else {
			d.Msg = compat.Sprintfb("cannot return %s: it holds a closure that %s (%s) builds in %s's frame", compat.ArgS(what), compat.ArgS(call), compat.ArgS(l.shortPos(src.Pos())), compat.ArgS(maker))
		}
		d.Text = compat.Concat(compat.Sprintfb("A function that returns a closure builds it in a region its caller provides. The region of this call is in %s's frame, which is reclaimed when %s returns.", compat.ArgS(maker), compat.ArgS(maker)), why)
	}
	return d
}

// container names the function whose frame n runs in: the function
// literal or range-over-func loop body it is in.
func (f *closureFlow) container(n ast.Node) string {
	var in ast.Node
	for _, r := range f.foreign {
		if n.Pos() > r.Pos() && n.Pos() < r.End() && (in == nil || r.Pos() > in.Pos()) {
			in = r
		}
	}
	switch in := in.(type) {
	case *ast.FuncLit:
		return compat.Concat("the function literal at ", f.l.shortPos(in.Pos()))
	case *ast.BlockStmt:
		return compat.Concat("the body of the loop at ", f.l.shortPos(in.Pos()))
	}
	return "this function"
}

// shortExpr returns e as source text for a message, with the arguments of
// a call and the elements of a composite literal left out when they hold a
// function literal or are long.
func shortExpr(e ast.Expr) string {
	s := types2.ExprString(e)
	if len(s) <= 40 && !strings.Contains(s, " literal)") {
		return s
	}
	switch e := ast.Unparen(e).(type) {
	case *ast.CallExpr:
		return compat.Concat(types2.ExprString(e.Fun), "(...)")
	case *ast.CompositeLit:
		if e.Type != nil {
			return compat.Concat(types2.ExprString(e.Type), "{...}")
		}
	case *ast.UnaryExpr:
		if e.Op == token.AND {
			return compat.Concat("&", shortExpr(e.X))
		}
	}
	return s
}

// varOwner names the function that declares v: name, the function job
// lowers, if v is declared there, or the innermost enclosing function that
// does.
func (l *Lowerer) varOwner(v *types2.Var, job *funcJob, name string) string {
	for j := job; j != nil; {
		var lo, hi token.Pos
		var n string
		switch {
		case j.decl != nil:
			lo, hi, n = j.decl.Pos(), j.decl.End(), j.decl.Name.Name
		case j.lit != nil:
			lo, hi, n = j.lit.Pos(), j.lit.End(), compat.Concat("the function literal at ", l.shortPos(j.lit.Pos()))
		}
		if j == job {
			n = name
		}
		if v.Pos() >= lo && v.Pos() < hi {
			return n
		}
		if j.parent == nil {
			break
		}
		j = j.parent.job
	}
	return "the function around it"
}

// calledFunc returns the declared function or concrete method a call
// names statically, or nil.
func calledFunc(info *types2.Info, call *ast.CallExpr) *types2.Func {
	fun := ast.Unparen(call.Fun)
	switch ix := fun.(type) {
	case *ast.IndexExpr:
		fun = ix.X
	case *ast.IndexListExpr:
		fun = ix.X
	}
	if se, ok := fun.(*ast.SelectorExpr); ok {
		if sel := info.Selections[se]; sel != nil {
			if sel.Kind() != types2.MethodVal || isInterface(sel.Recv()) || len(sel.Index()) != 1 {
				return nil
			}
			if _, ok := types2.Unalias(info.Types[se.X].Type).(*types2.TypeParam); ok {
				return nil
			}
			fn, _ := sel.Obj().(*types2.Func)
			return fn
		}
	}
	if id := staticFuncIdent(fun, info); id != nil {
		fn, _ := info.Uses[id].(*types2.Func)
		return fn
	}
	return nil
}
