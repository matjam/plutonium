	case exp > allBits:
		abs = shlNat(x.mant, exp-allBits)
	case exp < allBits:
		abs = shrNat(x.mant, allBits-exp)
	default:
		abs = x.mant.clone().norm()
	}
	return intOf(x.neg, abs), acc
