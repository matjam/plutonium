	const m = uint64(len(pow5tab) - 1)
	if n <= m {
		return floatUint64(false, pow5tab[n], prec)
	}
	z := floatUint64(false, pow5tab[m], prec)
	n -= m
	f := floatUint64(false, 5, prec+64)
	for n > 0 {
		if n&1 != 0 {
			z = bigFloat{prec: z.prec}.mul(&z, &f)
		}
		f = bigFloat{prec: f.prec}.mul(&f, &f)
		n >>= 1
	}
	return z
}

// floatFromString parses s with precision prec as big.Float.SetString
// does (base 0: prefixes, underscores, a radix point, and a decimal "e" or
// binary "p" exponent; also "Inf").
func floatFromString(s string, prec uint32) (bigFloat, bool) {
	z := bigFloat{prec: prec}
	switch s {
	case "Inf", "inf", "+Inf", "+inf":
		z.form = inf
		return z, true
	case "-Inf", "-inf":
		z.form = inf
		z.neg = true
		return z, true
	}
	neg, s, ok := scanSign(s)
	if !ok {
		return z, false
	}
	z.neg = neg
	mant, base, fcount, rest, ok := natScan(s, true)
	if !ok {
		return z, false
	}
	exp, ebase, rest, ok := scanExponent(rest, true)
	if !ok || rest != "" {
		return z, false
	}
	if len(mant) == 0 {
		z.form = zero
		return z, true
	}
	z.mant = mant.clone()
	exp2 := int64(len(z.mant))*64 - fnorm(z.mant)
	e2, exp5 := fracExponents(base, fcount)
	exp2 += e2
	switch ebase {
	case 10:
		exp5 += exp
		exp2 += exp
	case 2:
		exp2 += exp
	}
	if exp2 < minFloatExp || exp2 > maxFloatExp {
		return z, false // exponent overflow
	}
	z.form = finite
	z.exp = int32(exp2)
	if exp5 == 0 {
		z.round(0)
		return z, true
	}
	if exp5 < 0 {
		p := pow5(uint64(-exp5), z.prec+64)
		return bigFloat{prec: z.prec, neg: z.neg}.quo(&z, &p), true
	}
	p := pow5(uint64(exp5), z.prec+64)
	return bigFloat{prec: z.prec, neg: z.neg}.mul(&z, &p), true
}
