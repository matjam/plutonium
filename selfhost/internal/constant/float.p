	case x.exp > allBits:
		return rat{a: a.lsh(uint(x.exp - allBits)), b: natOne}
	case x.exp < allBits:
		return makeFrac(a, shlNat(natOne, uint(allBits-x.exp)))
	}
	return rat{a: a, b: natOne}
