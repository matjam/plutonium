// String returns a short, quoted (human-readable) form of the value. For
// numeric values the result may be an approximation; for String values it
// may be shortened. Use ExactString for an exact form.
func (x Value) String() string {
	switch x.kind {
	case Unknown:
		return "unknown"
	case Bool:
		if x.i != 0 {
			return "true"
		}
		return "false"
	case String:
		const maxLen = 72
		s := strconv.Quote(x.s)
		if utf8.RuneCountInString(s) > maxLen {
			i := 0
			for n := 0; n < maxLen-3; n++ {
				_, size := utf8.DecodeRuneInString(strings.SliceFrom(s, i))
				i += size
			}
			s = compat.Concat(strings.Slice(s, 0, i), "...")
		}
		return s
	}
	switch x.rep {
	case repInt64:
		return itoa(x.i)
	case repInt:
		return x.n.i.String()
	case repRat:
		f := floatRat(x.n.r, floatPrec)
		return floatString(&f)
	}
	return floatString(&x.n.f)
}

// floatString returns a decimal approximation of f, as go/constant's
// floatVal.String does.
func floatString(f *bigFloat) string {
	if f.form == inf {
		if f.neg {
			return "-Inf"
		}
		return "+Inf"
	}
	// Use exact formatting if f is in float64 range: it does not underflow
	// to 0 or overflow to infinity.
	if x, _ := f.toFloat(true); f.sign() == 0 == (x == 0) && !math.IsInf(x, 0) {
		s := compat.AppendFloat(nil, x, 'g', 6, 64)
		if !f.isInt() && indexByte(s, '.') < 0 {
			// f is not an integer, but its text does not show it.
			s = compat.AppendFloat(nil, x, 'g', -1, 64)
		}
		return compat.String(s)
	}
	// Out of float64 range: an approximate conversion to decimal.
	mant := *f
	exp := 0
	if f.form == finite {
		exp = int(f.exp)
		mant.exp = 0
	}
	m, _ := mant.toFloat(true)
	d := float64(exp) * (math.Ln2 / math.Ln10)
	e := int64(d)
	m *= math.Pow(10, d-float64(e))
	switch am := math.Abs(m); {
	case am < 1-0.5e-6:
		m *= 10
		e--
	case am >= 10:
		m /= 10
		e++
	}
	s := compat.AppendFloat(nil, m, 'g', 6, 64)
	s = compat.Append(s, 'e')
	if e >= 0 {
		s = compat.Append(s, '+')
	}
	return compat.String(compat.AppendInt(s, e, 10))
}

func indexByte(s []byte, c byte) int {
	for i := 0; i < len(s); i++ {
		if s[i] == c {
			return i
		}
	}
	return -1
}

// ExactString returns an exact, quoted (human-readable) form of the value.
// For a String value, StringVal gives the unquoted string.
func (x Value) ExactString() string {
	switch x.kind {
	case String:
		return strconv.Quote(x.s)
	case Int, Float:
		switch x.rep {
		case repRat:
			if x.n.r.isInt() {
				return x.n.r.a.String()
			}
			return x.n.r.String()
		case repFloat:
			return x.n.f.textP()
		}
	}
	return x.String()
}

// ----------------------------------------------------------------------------
// Operations

func is32bit(x int64) bool { return -1<<31 <= x && x <= 1<<31-1 }
func is63bit(x int64) bool { return -1<<62 <= x && x <= 1<<62-1 }

// UnaryOp returns the result of the unary expression op y. The operation
// must be defined for the operand. If prec > 0 it specifies the ^ (xor)
// result size in bits. If y is Unknown, the result is Unknown.
func UnaryOp(op token.Token, y Value, prec uint) Value {
	switch op {
	case token.ADD:
		switch y.kind {
		case Unknown, Int, Float:
			return y
		}
	case token.SUB:
		switch y.kind {
		case Unknown:
			return y
		case Int:
			if y.rep == repInt64 {
				if z := -y.i; z != y.i {
					return int64Val(z)
				}
			}
			return makeInt(y.bigOf().neg_())
		case Float:
			if y.rep == repRat {
				return makeRat(y.n.r.neg())
			}
			return makeFloat(y.n.f.negate())
		}
	case token.XOR:
		switch y.kind {
		case Unknown:
			return y
		case Int:
			z := y.bigOf().not()
			// For unsigned types the result is negative and so "too
			// large": limit it to the type's precision.
			if prec > 0 {
				z = z.andNot(int64ToInt(-1).lsh(prec))
			}
			return makeInt(z)
		}
	case token.NOT:
		switch y.kind {
		case Unknown:
			return y
		case Bool:
			return MakeBool(y.i == 0)
		}
	}
	panic(compat.Concat("constant: invalid unary operation ", op.String(), y.String()))
}

// ord orders the representations for match.
func ord(x Value) int {
	switch x.kind {
	case Unknown:
		return 0
	case Bool, String:
		return 1
	case Int:
		if x.rep == repInt64 {
			return 2
		}
		return 3
	case Float:
		if x.rep == repRat {
			return 4
		}
		return 5
	}
	return -1
}

// match returns x and y in the representation of the more complex of the
// two. If one is Unknown, both results are that value.
func match(x, y Value) (Value, Value) {
	switch ox, oy := ord(x), ord(y); {
	case ox < oy:
		x, y = match0(x, y)
	case ox > oy:
		y, x = match0(y, x)
	}
	return x, y
}

// match0 must only be called by match; ord(x) < ord(y).
func match0(x, y Value) (Value, Value) {
	switch ord(y) {
	case 3: // big Int
		if ord(x) == 2 {
			return Value{kind: Int, rep: repInt, n: pu.New(num{i: int64ToInt(x.i)})}, y
		}
	case 4: // fraction
		if ord(x) == 2 || ord(x) == 3 {
			return ratVal(x.ratOf()), y
		}
	case 5: // float
		if ord(x) >= 2 && ord(x) <= 4 {
			return floatVal(x.floatOf()), y
		}
	}
	// Force unknown and invalid values into the "x position" in callers.
	return x, x
}

// BinaryOp returns the result of the binary expression x op y. The
// operation must be defined for the operands. If one of the operands is
// Unknown, the result is Unknown. BinaryOp does not handle comparisons or
// shifts; use Compare or Shift instead.
//
// To force integer division of Int operands, use op == token.QUO_ASSIGN
// instead of token.QUO; the result is guaranteed to be Int in this case.
// Division by zero leads to a run-time panic.
func BinaryOp(x_ Value, op token.Token, y_ Value) Value {
	x, y := match(x_, y_)
	switch x.kind {
	case Unknown:
		return x
	case Bool:
		switch op {
		case token.LAND:
			return MakeBool(x.i != 0 && y.i != 0)
		case token.LOR:
			return MakeBool(x.i != 0 || y.i != 0)
		}
	case String:
		if op == token.ADD {
			return MakeString(compat.Concat(x.s, y.s))
		}
	case Int:
		if x.rep == repInt64 {
			if v, ok := int64Op(x.i, op, y.i); ok {
				return v
			}
			break
		}
		a, b := x.n.i, y.n.i
		switch op {
		case token.ADD:
			return makeInt(a.add(b))
		case token.SUB:
			return makeInt(a.sub(b))
		case token.MUL:
			return makeInt(a.mul(b))
		case token.QUO:
			if len(b.abs) == 0 {
				panic("division by zero")
			}
			return makeRat(makeFrac(intOf(a.neg != b.neg, a.abs), b.abs))
		case token.QUO_ASSIGN:
			q, _ := a.quoRem(b)
			return makeInt(q)
		case token.REM:
			_, r := a.quoRem(b)
			return makeInt(r)
		case token.AND:
			return makeInt(a.and(b))
		case token.OR:
			return makeInt(a.or(b))
		case token.XOR:
			return makeInt(a.xor(b))
		case token.AND_NOT:
			return makeInt(a.andNot(b))
		}
	case Float:
		if x.rep == repRat {
			a, b := x.n.r, y.n.r
			switch op {
			case token.ADD:
				return makeRat(a.add(b))
			case token.SUB:
				return makeRat(a.sub(b))
			case token.MUL:
				return makeRat(a.mul(b))
			case token.QUO:
				return makeRat(a.quo(b))
			}
			break
		}
		a, b := &x.n.f, &y.n.f
		switch op {
		case token.ADD:
			return makeFloat(newFloat().add(a, b))
		case token.SUB:
			return makeFloat(newFloat().sub(a, b))
		case token.MUL:
			return makeFloat(newFloat().mul(a, b))
		case token.QUO:
			return makeFloat(newFloat().quo(a, b))
		}
	}
	panic(compat.Concat("constant: invalid binary operation ", x_.String(), " ", op.String(), " ", y_.String()))
}

// int64Op computes a op b for Int values that fit in int64, going to big
// integers where the result might not.
func int64Op(a int64, op token.Token, b int64) (Value, bool) {
	var c int64
	switch op {
	case token.ADD:
		if !is63bit(a) || !is63bit(b) {
			return makeInt(int64ToInt(a).add(int64ToInt(b))), true
		}
		c = a + b
	case token.SUB:
		if !is63bit(a) || !is63bit(b) {
			return makeInt(int64ToInt(a).sub(int64ToInt(b))), true
		}
		c = a - b
	case token.MUL:
		if !is32bit(a) || !is32bit(b) {
			return makeInt(int64ToInt(a).mul(int64ToInt(b))), true
		}
		c = a * b
	case token.QUO:
		if b == 0 {
			panic("division by zero")
		}
		n, d := int64ToInt(a), int64ToInt(b)
		return makeRat(makeFrac(intOf(n.neg != d.neg, n.abs), d.abs)), true
	case token.QUO_ASSIGN:
		c = a / b
	case token.REM:
		c = a % b
	case token.AND:
		c = a & b
	case token.OR:
		c = a | b
	case token.XOR:
		c = a ^ b
	case token.AND_NOT:
		c = a &^ b
	default:
		return Value{}, false
	}
	return int64Val(c), true
}

// Shift returns the result of the shift expression x op s with op ==
// token.SHL or token.SHR (<< or >>). x must be an Int or an Unknown. If x
// is Unknown, the result is x.
func Shift(x Value, op token.Token, s uint) Value {
	switch x.kind {
	case Unknown:
		return x
	case Int:
		if s == 0 {
			return x
		}
		switch op {
		case token.SHL:
			return makeInt(x.bigOf().lsh(s))
		case token.SHR:
			if x.rep == repInt64 {
				return int64Val(x.i >> s)
			}
			return makeInt(x.n.i.rsh(s))
		}
	}
	panic(compat.Concat("constant: invalid shift ", x.String(), " ", op.String(), " ", compat.String(appendUint(nil, uint64(s), 0))))
}

func cmpZero(x int, op token.Token) bool {
	switch op {
	case token.EQL:
		return x == 0
	case token.NEQ:
		return x != 0
	case token.LSS:
		return x < 0
	case token.LEQ:
		return x <= 0
	case token.GTR:
		return x > 0
	case token.GEQ:
		return x >= 0
	}
	panic(compat.Concat("constant: invalid comparison ", itoa(int64(x)), " ", op.String(), " 0"))
}

// Compare returns the result of the comparison x op y. The comparison must
// be defined for the operands. If one of the operands is Unknown, the
// result is false.
func Compare(x_ Value, op token.Token, y_ Value) bool {
	x, y := match(x_, y_)
	switch x.kind {
	case Unknown:
		return false
	case Bool:
		switch op {
		case token.EQL:
			return x.i == y.i
		case token.NEQ:
			return x.i != y.i
		}
	case String:
		switch op {
		case token.EQL:
			return x.s == y.s
		case token.NEQ:
			return x.s != y.s
		case token.LSS:
			return x.s < y.s
		case token.LEQ:
			return x.s <= y.s
		case token.GTR:
			return x.s > y.s
		case token.GEQ:
			return x.s >= y.s
		}
	case Int:
		if x.rep == repInt64 {
			c := 0
			switch {
			case x.i < y.i:
				c = -1
			case x.i > y.i:
				c = 1
			}
			return cmpZero(c, op)
		}
		return cmpZero(x.n.i.cmp(y.n.i), op)
	case Float:
		if x.rep == repRat {
			return cmpZero(x.n.r.cmp(y.n.r), op)
		}
		return cmpZero(x.n.f.cmp(&y.n.f), op)
	}
	panic(compat.Concat("constant: invalid comparison ", x_.String(), " ", op.String(), " ", y_.String()))
}
