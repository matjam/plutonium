// hex reads bytes in hexadecimal; "-" is nil, "=" is empty but not nil.
func (r *reader) hex() []byte {
	w := r.word()
	if r.err != nil {
		return nil
	}
	if len(w) == 1 && w[0] == '-' {
		return nil
	}
	if len(w) == 1 && w[0] == '=' {
		return compat.Clone([]byte{})
	}
	if len(w)%2 != 0 {
		r.fail("odd hex string")
		return nil
	}
	out := compat.Make[byte](len(w) / 2)
	for i := range out {
		hi, lo := hexDigit(w[2*i]), hexDigit(w[2*i+1])
		if hi < 0 || lo < 0 {
			r.fail("bad hex digit")
			return nil
		}
		out[i] = byte(hi<<4 | lo)
	}
	return out
}

func hexDigit(c byte) int {
	switch {
	case '0' <= c && c <= '9':
		return int(c - '0')
	case 'a' <= c && c <= 'f':
		return int(c-'a') + 10
	}
	return -1
}

