// implementsAllocator reports whether T is, or implements, the runtime's
// Allocator interface.
func implementsAllocator(a *analyzer, T types2.Type) bool {
	if T == nil {
		return false
	}
	obj := a.allocatorIface()
	if obj == nil {
		return false
	}
	iface, _ := obj.Type().Underlying().(*types2.Interface)
	if iface == nil {
		return false
	}
	return types2.Implements(T, iface) || types2.Implements(types2.NewPointer(T), iface)
}

// allocatorIface returns pluto/rt.Allocator, or nil.
func (a *analyzer) allocatorIface() types2.Object {
	for _, p := range a.prog.Packages {
		if p.Path == "pluto/rt" {
			return p.Types.Scope().Lookup("Allocator")
		}
	}
	return nil
}

// calleeIdent returns the identifier naming a call's function, or nil.
func calleeIdent(x *ast.CallExpr) *ast.Ident {
	switch f := ast.Unparen(x.Fun).(type) {
	case *ast.Ident:
		return f
	case *ast.SelectorExpr:
		return f.Sel
	}
	return nil
}

// varOf returns the variable an identifier names, or nil.
func (ov *ownedViews) varOf(id *ast.Ident) *types2.Var {
	if v, ok := ov.a.uses[id].(*types2.Var); ok {
		return v
	}
	v, _ := ov.a.defs[id].(*types2.Var)
	return v
}
