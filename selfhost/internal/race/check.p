		for _, x := range g.accesses {
			base, id, _, ok := syncedSplit(x.place)
			if !ok || !a.isMapID(id) {
				continue
			}
			own := base.root.kind == rFresh && base.path == "" && !crossed[base.root.node]
			if !g.main && !own {
				marked[id] = true // a task reaches a map it did not make
			}
