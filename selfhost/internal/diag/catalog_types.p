// The type checker comes from go/types, and so do its error codes and their
// documentation (catalog_go.go, generated by gencatalog). Each code becomes
// a catalog entry: the hand-written plain-words text in goPlain where there
// is one, otherwise the go/types description, with its spec quote and
// first example.

// A goDoc is go/types' documentation of an error code.
type goDoc struct {
	Value    int
	Name     string
	Text     string   // description, paragraphs separated by "\n"
	Spec     string   // a quote from the Go spec, or ""
	Examples []string // code with the error
}

