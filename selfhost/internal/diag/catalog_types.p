func init() {
	for _, d := range goDocs {
		e := pu.New(Entry{Code: CheckerCode(typerr.Code(d.Value)), Name: d.Name})
		if p, ok := goPlain[d.Name]; ok {
			e.Text, e.Fix, e.Spec, e.Example, e.Fixed = p.Text, p.Fix, p.Spec, p.Example, p.Fixed
		} else {
			e.Text = describeDoc(d)
			e.Spec = goSections[d.Name]
		}
		if e.Example == "" && len(d.Examples) > 0 {
			e.Example = d.Examples[0]
		}
		register(e)
	}
}

// describeDoc turns go/types' description of a code into an explanation:
// "UnusedImport occurs when ..." becomes "This error occurs when ...". The
// quotes from Go's specification that go/types documents are left out; the
// entry's Spec names the section of the Plutonium spec instead (goSections).
func describeDoc(d goDoc) string {
	text := d.Text
	if rest, ok := strings.CutPrefix(text, compat.Concat(d.Name, " ")); ok {
		text = compat.Concat("This error ", rest)
	}
	return text
}
