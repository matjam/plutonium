		changed := false
		for _, l := range f.Loops().Loops {
			if unrollLoop(f, l, limit) {
				changed = true
				break // the loop nest is stale
			}
		}
		if !changed {
			return
		}
		// Fold the copies' induction variables, which may give inner
		// loops constant bounds.
		ssa.CopyElim(f)
		Simplify(f)
		SimplifyCFG(f)
	}
}

