		return true
	}
	*budget--
	if *budget < 0 {
		return false
	}
	if v.Op == ssa.OpPhi {
		return entry && v.Block == l.Header
	}
	if !genPure(v.Op) {
		return false
	}
	for _, a := range v.Args {
		if !g.cloneable(l, a, entry, budget) {
			return false
		}
	}
	return true
}

