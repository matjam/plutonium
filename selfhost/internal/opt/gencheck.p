	if !l.Contains(g.ln, v.Block) {
		return v
	}
	if w := memo[v]; w != nil {
		return w
	}
	var w *ssa.Value
	if v.Op == ssa.OpPhi {
		w = v.Args[pi]
	} else {
		args := compat.Make[*ssa.Value](len(v.Args))
		for i, a := range v.Args {
			args[i] = g.cloneEntry(l, pre, pi, a, memo)
		}
		w = g.newValue(pre, v, v.Op, v.Type, args...)
		w.AuxInt, w.Aux = v.AuxInt, v.Aux
	}
	memo[v] = w
	return w
