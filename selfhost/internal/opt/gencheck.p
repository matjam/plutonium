	for changed := true; changed; {
		changed = false
		for _, b := range order {
			g.meet(b, in[b.ID], out)
			copy(cur, in[b.ID])
			g.transfer(b, cur, false)
			if !equalBits(cur, out[b.ID]) {
				copy(out[b.ID], cur)
				changed = true
			}
		}
	}
	if decide {
		for _, b := range order {
			copy(cur, in[b.ID])
			g.transfer(b, cur, true)
		}
	}
	return out
