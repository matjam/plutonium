			if b == f.Entry {
				g.entryState(cur)
			}
			g.transfer(b, cur, decide)
			out[b.ID] = compat.Append([]uint64(nil), cur...)
		}
		return out
	}
	in := compat.Make[[]uint64](f.NumBlocks())
	for _, b := range order {
		in[b.ID] = compat.Make[uint64](n)
		out[b.ID] = compat.Make[uint64](n)
		if b != f.Entry {
			for i := range out[b.ID] {
				out[b.ID][i] = ^uint64(0)
			}
		}
