	bits := floatBits(v)
	if bits == 0 {
		s.emit(new(MInst{Op: MXORPS, Size: 16, Dst: RegOp(r), Src: RegOp(r)}))
		return
	}
	s.emit(new(MInst{Op: MMOVSF, Size: sizeOf(v.Type), Dst: RegOp(r), Src: MemOp(s.constMem(bits, bits))}))
}

// floatBits returns the bits of float constant v at its own width.
func floatBits(v *ssa.Value) uint64 {
	bits := uint64(v.AuxInt)
	if v.Type.Size == 4 {
		bits = uint64(math.Float32bits(float32(math.Float64frombits(bits))))
	}
	return bits
}

// constMem returns a RIP-relative operand for a 16-byte read-only constant
// holding lo and hi (little-endian), adding it to the function's pool.
func (s *isel) constMem(lo, hi uint64) Mem {
	var b [16]byte
	compat.PutUint64(b[:8], lo)
	compat.PutUint64(b[8:], hi)
	sym := compat.MapAt(s.mf.constSyms, b)
	if sym == nil {
		if s.mf.constSyms == nil {
			s.mf.constSyms = compat.NewMapFunc[[16]byte, *ssa.Sym](0, func(k [16]byte) uint64 {
				h := uint64(0)
				h = compat.Mix(h, compat.HashBytes(k[:]))
				return h
			})
		}
		sym = new(ssa.Sym{Name: compat.Sprintf("pluto.const.%016x%016x", hi, lo), Kind: ssa.SymData})
		s.mf.constSyms.Set(b, sym)
		s.mf.consts = compat.Append(s.mf.consts, Const{Sym: sym, Bytes: b})
	}
	return Mem{Base: NoReg, Index: NoReg, Sym: sym}
}

// floatOperand returns float v as an instruction source: a constant from
// the pool, or a register.
func (s *isel) floatOperand(v *ssa.Value) Operand {
	if v.Op == ssa.OpConstFloat && s.vregs[v.ID] == NoReg {
		if bits := floatBits(v); bits != 0 {
			return MemOp(s.constMem(bits, bits))
		}
	}
	return RegOp(s.reg(v))
}

// fitsImm32 reports whether c is representable as a sign-extended imm32.
func fitsImm32(c int64) bool { return c == int64(int32(c)) }

// operand returns v as an instruction source: an immediate when v is a
// constant that fits, otherwise a register.
func (s *isel) operand(v *ssa.Value) Operand {
	if v.Op == ssa.OpConst && s.vregs[v.ID] == NoReg {
		c := v.AuxInt
		if sizeOf(v.Type) < 8 {
			c = int64(int32(c)) // narrower operations use the low bits
			if sizeOf(v.Type) == 1 {
				c = int64(int8(c))
			} else if sizeOf(v.Type) == 2 {
				c = int64(int16(c))
			}
		}
		if fitsImm32(c) {
			return ImmOp(c)
		}
	}
	return RegOp(s.reg(v))
}

// addr returns a memory operand for pointer value p, folding constant
// offsets, slot and symbol addresses and scaled indexes.
func (s *isel) addr(p *ssa.Value) Mem {
	if s.vregs[p.ID] != NoReg {
		return BaseMem(s.vregs[p.ID], 0)
	}
	switch p.Op {
	case ssa.OpSlotAddr:
		return Mem{Base: NoReg, Index: NoReg, Slot: p.Aux.(*ssa.Slot)}
	case ssa.OpSymAddr:
		sym := p.Aux.(*ssa.Sym)
		if sym.PerCPU {
			// %gs:sym: the symbol's address is its offset in the
			// per-CPU block, which GS points at.
			return Mem{Base: NoReg, Index: NoReg, Sym: sym, Seg: SegGS}
		}
		return Mem{Base: NoReg, Index: NoReg, Sym: sym}
	case ssa.OpOffPtr:
		m := s.addr(p.Args[0])
		if fitsImm32(m.Disp + p.AuxInt) {
			m.Disp += p.AuxInt
			return m
		}
		return s.farOffset(p.Args[0], p.AuxInt)
	case ssa.OpAddPtr:
		base, idx := p.Args[0], p.Args[1]
		if idx.Op == ssa.OpPerCPUOffset && s.vregs[idx.ID] == NoReg {
			// A per-CPU variable's address: base (the block) plus the
			// symbol as an absolute displacement.
			if m := s.addr(base); m.Sym == nil && m.Seg == SegNone && m.Slot == nil && !m.ArgSlot && !m.OutArg {
				m.Sym = idx.Aux.(*ssa.Sym)
				return m
			}
		}
		if idx.Op == ssa.OpConst {
			m := s.addr(base)
			if fitsImm32(m.Disp + idx.AuxInt) {
				m.Disp += idx.AuxInt
				return m
			}
			return s.farOffset(base, idx.AuxInt)
		}
		m := s.addr(base)
		if m.Index != NoReg {
			m = BaseMem(s.reg(base), 0)
		}
		// With a symbol and no base this is absolute sym+disp32 plus the
		// scaled index, which the small and kernel code models allow.
		m.Index, m.Scale = s.index(idx)
		return m
	}
	return BaseMem(s.reg(p), 0)
}

// farOffset addresses base+off for an offset too large for a
// displacement, with the offset in an index register. (Falling back to
// reg(p) for such a p would come straight back here through LEA.)
func (s *isel) farOffset(base *ssa.Value, off int64) Mem {
	b := s.reg(base)
	c := s.newReg(ssa.TI64)
	s.loadConst(c, off, 8)
	return Mem{Base: b, Index: c, Scale: 1}
}

// ----------------------------------------------------------------------------
// Function entry

// abiLocs assigns ABI locations to a list of scalar types: a register per
// value while registers last, then 8-byte stack slots in order.
type abiLoc struct {
	reg   Reg
	stack int64 // offset in the stack argument area, if reg == NoReg
}

func abiLocs(types []*ssa.Type, intRegs, floatRegs []Reg, onStack []bool) ([]abiLoc, int64) {
	locs := make([]abiLoc, len(types))
	ni, nf := 0, 0
	var stack int64
	for i, t := range types {
		forced := onStack != nil && i < len(onStack) && onStack[i]
		switch {
		case !forced && t.IsFloat() && nf < len(floatRegs):
			locs[i] = abiLoc{reg: floatRegs[nf]}
			nf++
		case !forced && !t.IsFloat() && ni < len(intRegs):
			locs[i] = abiLoc{reg: intRegs[ni]}
			ni++
		default:
			locs[i] = abiLoc{reg: NoReg, stack: stack}
			stack += 8
		}
	}
	return locs, stack
}

// entry copies the incoming arguments out of their ABI registers before
// anything can clobber them.
func (s *isel) entry() {
	if s.mf.interrupt {
		s.interruptEntry()
		return
	}
	locs, _ := abiLocs(s.f.Params, intArgRegs, floatArgRegs, s.f.ParamOnStack)
	var defs []Reg
	for _, l := range locs {
		if l.reg != NoReg {
			defs = compat.Append(defs, l.reg)
		}
	}
	defs = compat.Append(defs, closureReg)
	s.emit(new(MInst{Op: MDEF, ImplicitDefs: defs}))
	for _, b := range s.f.Blocks {
		for _, v := range b.Values {
			switch v.Op {
			case ssa.OpArg:
				r := s.newReg(v.Type)
				l := locs[v.AuxInt]
				if l.reg != NoReg {
					s.copyRegTyped(r, l.reg, v.Type)
				} else {
					s.load(r, Mem{Base: NoReg, Index: NoReg, ArgSlot: true, ArgOff: l.stack}, v.Type)
				}
				s.vregs[v.ID] = r
			case ssa.OpClosurePtr:
				r := s.newReg(ssa.TPtr)
				s.copyReg(r, closureReg, 8)
				s.vregs[v.ID] = r
			case ssa.OpReturnAddr:
				// The return address sits just below the incoming stack
				// arguments.
				r := s.newReg(v.Type)
				s.load(r, Mem{Base: NoReg, Index: NoReg, ArgSlot: true, ArgOff: -8}, v.Type)
				s.vregs[v.ID] = r
			}
		}
	}
}

// interruptEntry gives an interrupt handler its parameters. Nothing arrives
// in registers: the CPU has pushed the interrupt frame (RIP, CS, RFLAGS, RSP,
// SS) and, for some exceptions, an error code below it. Parameter 0 is the
// frame's address and parameter 1 the error code. ArgOff is measured from
// the stack pointer on entry, where there is no return address.
func (s *isel) interruptEntry() {
	frameOff := int64(0)
	if s.mf.errCode {
		frameOff = 8
	}
	for _, b := range s.f.Blocks {
		for _, v := range b.Values {
			if v.Op == ssa.OpReturnAddr {
				// The handler returns to the interrupted RIP, the
				// first word of the frame.
				r := s.newReg(v.Type)
				s.load(r, Mem{Base: NoReg, Index: NoReg, ArgSlot: true, ArgOff: frameOff}, v.Type)
				s.vregs[v.ID] = r
				continue
			}
			if v.Op != ssa.OpArg {
				continue
			}
			r := s.newReg(v.Type)
			if v.AuxInt == 0 {
				m := Mem{Base: NoReg, Index: NoReg, ArgSlot: true, ArgOff: frameOff}
				s.emit(new(MInst{Op: MLEA, Size: 8, Dst: RegOp(r), Src: MemOp(m)}))
			} else {
				s.load(r, Mem{Base: NoReg, Index: NoReg, ArgSlot: true}, v.Type)
			}
			s.vregs[v.ID] = r
		}
	}
}

func (s *isel) copyRegTyped(dst, src Reg, t *ssa.Type) {
	s.copyReg(dst, src, 8)
}

func (s *isel) load(r Reg, m Mem, t *ssa.Type) {
	if s.usesSSE(t) {
		s.emit(new(MInst{Op: MMOVSF, Size: sizeOf(t), Dst: RegOp(r), Src: MemOp(m)}))
		return
	}
	size := sizeOf(t)
	if size < 4 {
		// Zero-extend narrow loads: a partial register write would depend
		// on the register's old value. ZeroExt of a load relies on this.
		s.emit(new(MInst{Op: MMOVZX, Size: 4, SrcSize: size, Dst: RegOp(r), Src: MemOp(m)}))
		return
	}
	s.emit(new(MInst{Op: MMOV, Size: size, Dst: RegOp(r), Src: MemOp(m)}))
}

func (s *isel) store(m Mem, v *ssa.Value) {
	if v.Op == ssa.OpVLane && s.fused[v.ID] {
		x := s.reg(v.Args[0])
		if v.AuxInt == 0 {
			s.emit(new(MInst{Op: MMOVSF, Size: 8, Dst: MemOp(m), Src: RegOp(x)}))
		} else {
			s.emit(new(MInst{Op: MMOVHPD, Size: 8, Dst: MemOp(m), Src: RegOp(x)}))
		}
		return
	}
	if s.usesSSE(v.Type) {
		s.emit(new(MInst{Op: MMOVSF, Size: sizeOf(v.Type), Dst: MemOp(m), Src: RegOp(s.reg(v))}))
		return
	}
	s.emit(new(MInst{Op: MMOV, Size: sizeOf(v.Type), Dst: MemOp(m), Src: s.operand(v)}))
}

// ----------------------------------------------------------------------------
// Values

func (s *isel) def(v *ssa.Value) Reg {
	r := s.newReg(v.Type)
	s.vregs[v.ID] = r
	return r
}

func (s *isel) value(v *ssa.Value) error {
	if s.noSSE && needsSSE(v) {
		return fmt.Errorf("amd64: %s: %s needs SSE, which this function may not use (kernel mode without //pu:fpu)", s.f.Name, v.LongString())
	}
	if isLazy(v) || s.fused[v.ID] || s.folded[v.ID] {
		return nil
	}
	size := sizeOf(v.Type)
	switch v.Op {
	case ssa.OpPhi, ssa.OpInitMem, ssa.OpVarDef, ssa.OpVolatileRead, ssa.OpArg, ssa.OpClosurePtr, ssa.OpReturnAddr, ssa.OpUnreachableValue:
		// Handled elsewhere or produce no code.
		if v.Op == ssa.OpUnreachableValue && !v.Type.IsMem() {
			r := s.def(v)
			s.emit(new(MInst{Op: MDEF, ImplicitDefs: compat.Clone([]Reg{r})}))
		}
		return nil

	case ssa.OpCodeAddr:
		s.emit(new(MInst{Op: MLEA, Size: 8, Dst: RegOp(s.def(v)), Src: MemOp(Mem{Base: NoReg, Index: NoReg, RIP: true})}))

	case ssa.OpCopy:
		if v.Type.IsMem() {
			return nil
		}
		s.copyReg(s.def(v), s.reg(v.Args[0]), size)

	case ssa.OpAdd, ssa.OpSub, ssa.OpAnd, ssa.OpOr, ssa.OpXor:
		if v.Op == ssa.OpAdd && s.leaAdd(v) {
			break
		}
		op := compat.MapAt(compat.MapOf[ssa.Op, MOp](
			compat.Pair[ssa.Op, MOp]{ssa.OpAdd, MADD},
			compat.Pair[ssa.Op, MOp]{ssa.OpSub, MSUB},
			compat.Pair[ssa.Op, MOp]{ssa.OpAnd, MAND},
			compat.Pair[ssa.Op, MOp]{ssa.OpOr, MOR},
			compat.Pair[ssa.Op, MOp]{ssa.OpXor, MXOR},
		), v.Op)
		x, src := s.aluArgs(v)
		d := s.def(v)
		s.copyReg(d, s.reg(x), size)
		s.emit(new(MInst{Op: op, Size: size, Dst: RegOp(d), Src: src}))

	case ssa.OpAndNot:
		d := s.def(v)
		t := s.newReg(v.Type)
		s.copyReg(t, s.reg(v.Args[1]), size)
		s.emit(new(MInst{Op: MNOT, Size: size, Dst: RegOp(t)}))
		s.copyReg(d, s.reg(v.Args[0]), size)
		s.emit(new(MInst{Op: MAND, Size: size, Dst: RegOp(d), Src: RegOp(t)}))

	case ssa.OpMul:
		d := s.def(v)
		opSize := max(size, 2)
		if x, sc := leaMul(v); sc > 0 {
			// x*3/5/9 in one cycle instead of three.
			r := s.reg(x)
			s.emit(new(MInst{Op: MLEA, Size: size, Dst: RegOp(d), Src: MemOp(Mem{Base: r, Index: r, Scale: sc})}))
			break
		}
		if c := v.Args[1]; c.Op == ssa.OpConst && fitsImm32(c.AuxInt) {
			s.emit(new(MInst{Op: MIMUL3, Size: opSize, Dst: RegOp(d), Src: RegOp(s.reg(v.Args[0])), Imm: c.AuxInt}))
			break
		}
		s.copyReg(d, s.reg(v.Args[0]), size)
		s.emit(new(MInst{Op: MIMUL, Size: opSize, Dst: RegOp(d), Src: RegOp(s.reg(v.Args[1]))}))

	case ssa.OpMulHi, ssa.OpMulHiu:
		d := s.def(v)
		s.copyReg(RAX, s.reg(v.Args[0]), 8)
		op := MMUL1
		if v.Op == ssa.OpMulHi {
			op = MIMUL1
		}
		s.emit(new(MInst{Op: op, Size: size, Src: RegOp(s.reg(v.Args[1])), ImplicitUses: compat.Clone([]Reg{RAX}), ImplicitDefs: compat.Clone([]Reg{RAX, RDX})}))
		s.copyReg(d, RDX, size)

	case ssa.OpDiv, ssa.OpDivu, ssa.OpMod, ssa.OpModu:
		s.divide(v)

	case ssa.OpShl, ssa.OpShrL, ssa.OpShrA, ssa.OpRotl:
		s.shift(v)

	case ssa.OpNeg:
		d := s.def(v)
		s.copyReg(d, s.reg(v.Args[0]), size)
		s.emit(new(MInst{Op: MNEG, Size: size, Dst: RegOp(d)}))
	case ssa.OpCom:
		d := s.def(v)
		s.copyReg(d, s.reg(v.Args[0]), size)
		s.emit(new(MInst{Op: MNOT, Size: size, Dst: RegOp(d)}))
	case ssa.OpNot:
		d := s.def(v)
		s.copyReg(d, s.reg(v.Args[0]), 1)
		s.emit(new(MInst{Op: MXOR, Size: 1, Dst: RegOp(d), Src: ImmOp(1)}))

	case ssa.OpFAdd, ssa.OpFSub, ssa.OpFMul, ssa.OpFDiv:
		op := compat.MapAt(compat.MapOf[ssa.Op, MOp](
			compat.Pair[ssa.Op, MOp]{ssa.OpFAdd, MADDSF},
			compat.Pair[ssa.Op, MOp]{ssa.OpFSub, MSUBSF},
			compat.Pair[ssa.Op, MOp]{ssa.OpFMul, MMULSF},
			compat.Pair[ssa.Op, MOp]{ssa.OpFDiv, MDIVSF},
		), v.Op)
		x, src := s.aluArgs(v)
		d := s.def(v)
		s.copyReg(d, s.reg(x), size)
		s.emit(new(MInst{Op: op, Size: size, Dst: RegOp(d), Src: src}))
	case ssa.OpFNeg, ssa.OpFAbs:
		d := s.def(v)
		s.copyReg(d, s.reg(v.Args[0]), size)
		// The mask fills every lane: packed operations read all 16 bytes.
		sign := uint64(1 << 63)
		if size == 4 {
			sign = 0x80000000_80000000
		}
		op := MXORPS
		if v.Op == ssa.OpFAbs {
			sign = ^sign
			op = MANDPS
		}
		s.emit(new(MInst{Op: op, Size: 16, Dst: RegOp(d), Src: MemOp(s.constMem(sign, sign))}))
	case ssa.OpFSqrt:
		d := s.def(v)
		s.emit(new(MInst{Op: MSQRTSF, Size: size, Dst: RegOp(d), Src: RegOp(s.reg(v.Args[0]))}))

	case ssa.OpVPack:
		a, b := v.Args[0], v.Args[1]
		d := s.def(v)
		s.copyReg(d, s.reg(a), 16)
		switch {
		case b == a:
			s.emit(new(MInst{Op: MUNPCKLPD, Size: 16, Dst: RegOp(d), Src: RegOp(d)}))
		case s.folded[b.ID]:
			s.emit(new(MInst{Op: MMOVHPD, Size: 8, Dst: RegOp(d), Src: MemOp(s.addr(b.Args[0]))}))
		default:
			s.emit(new(MInst{Op: MUNPCKLPD, Size: 16, Dst: RegOp(d), Src: RegOp(s.reg(b))}))
		}
	case ssa.OpVLane:
		// d holds a scalar and may be spilled as one, so it never holds
		// the whole vector: lane 1 is shuffled straight into it.
		d := s.def(v)
		if v.AuxInt == 0 {
			s.copyReg(d, s.reg(v.Args[0]), 16)
		} else {
			s.emit(new(MInst{Op: MPSHUFD, Size: 16, Dst: RegOp(d), Src: RegOp(s.reg(v.Args[0])), Imm: 0xEE}))
		}

	case ssa.OpEq, ssa.OpNe, ssa.OpLess, ssa.OpLeq, ssa.OpLessu, ssa.OpLequ:
		cond := s.intCompare(v)
		s.setcc(s.def(v), cond)
	case ssa.OpFEq, ssa.OpFNe, ssa.OpFLess, ssa.OpFLeq:
		s.floatCompareValue(v)

	case ssa.OpSelect:
		s.selectValue(v)

	case ssa.OpSignExt:
		from := sizeOf(v.Args[0].Type)
		s.emit(new(MInst{Op: MMOVSX, Size: size, SrcSize: from, Dst: RegOp(s.def(v)), Src: RegOp(s.reg(v.Args[0]))}))
	case ssa.OpZeroExt:
		from := sizeOf(v.Args[0].Type)
		d := s.def(v)
		if a := v.Args[0]; a.Op == ssa.OpLoad && from < 4 && !a.Type.IsFloat() {
			// load already zero-extended it.
			s.copyReg(d, s.reg(a), 8)
		} else if from == 4 {
			s.emit(new(MInst{Op: MMOV, Size: 4, Dst: RegOp(d), Src: RegOp(s.reg(v.Args[0]))}))
		} else {
			s.emit(new(MInst{Op: MMOVZX, Size: 4, SrcSize: from, Dst: RegOp(d), Src: RegOp(s.reg(v.Args[0]))}))
		}
	case ssa.OpTrunc:
		s.copyReg(s.def(v), s.reg(v.Args[0]), size)

	case ssa.OpIntToFloat:
		d := s.def(v)
		s.emit(new(MInst{Op: MXORPS, Size: 16, Dst: RegOp(d), Src: RegOp(d)})) // break the false dependency
		s.emit(new(MInst{Op: MCVTSI2F, Size: size, SrcSize: sizeOf(v.Args[0].Type), Dst: RegOp(d), Src: RegOp(s.reg(v.Args[0]))}))
	case ssa.OpFloatToInt:
		s.emit(new(MInst{Op: MCVTTF2SI, Size: size, SrcSize: sizeOf(v.Args[0].Type), Dst: RegOp(s.def(v)), Src: RegOp(s.reg(v.Args[0]))}))
	case ssa.OpFloatConv:
		s.emit(new(MInst{Op: MCVTF2F, Size: size, SrcSize: sizeOf(v.Args[0].Type), Dst: RegOp(s.def(v)), Src: RegOp(s.reg(v.Args[0]))}))
	case ssa.OpBitcast:
		a := v.Args[0]
		if s.usesSSE(a.Type) != s.usesSSE(v.Type) {
			s.emit(new(MInst{Op: MMOVQ, Size: size, Dst: RegOp(s.def(v)), Src: RegOp(s.reg(a))}))
		} else {
			s.copyReg(s.def(v), s.reg(a), size)
		}

	case ssa.OpBswap:
		d := s.def(v)
		s.copyReg(d, s.reg(v.Args[0]), size)
		if size == 2 {
			s.emit(new(MInst{Op: MROL, Size: 2, Dst: RegOp(d), Src: ImmOp(8)}))
		} else {
			s.emit(new(MInst{Op: MBSWAP, Size: size, Dst: RegOp(d)}))
		}
	case ssa.OpCtz, ssa.OpClz:
		s.bitScan(v)
	case ssa.OpPopCount:
		s.popCount(v)

	case ssa.OpLoad:
		s.load(s.def(v), s.addr(v.Args[0]), v.Type)
	case ssa.OpStore:
		s.store(s.addr(v.Args[0]), v.Args[1])
	case ssa.OpZero:
		s.zero(v.Args[0], v.AuxInt)
	case ssa.OpMove:
		s.move(v.Args[0], v.Args[1], v.AuxInt)
	case ssa.OpFill:
		s.lea(RDI, s.addr(v.Args[0]))
		s.copyReg(RCX, s.reg(v.Args[2]), 8)
		s.copyReg(RAX, s.reg(v.Args[1]), 8)
		s.emit(new(MInst{Op: MREPSTOSB, ImplicitUses: compat.Clone([]Reg{RDI, RCX, RAX}), ImplicitDefs: compat.Clone([]Reg{RDI, RCX})}))

	case ssa.OpCall, ssa.OpCallInd:
		s.call(v)
	case ssa.OpIntrinsic:
		return s.intrinsic(v)
	case ssa.OpSelectN:
		if v.Type.IsMem() {
			return nil
		}
		// Result registers were copied out by the call.
		if s.vregs[v.ID] == NoReg {
			return fmt.Errorf("amd64: %s: result not produced by its call", v.LongString())
		}

	default:
		return fmt.Errorf("amd64: cannot select %s", v.LongString())
	}
	return nil
}

// ----------------------------------------------------------------------------
// Division and shifts

func (s *isel) divide(v *ssa.Value) {
	size := sizeOf(v.Type)
	signed := v.Op == ssa.OpDiv || v.Op == ssa.OpMod
	a, b := s.reg(v.Args[0]), s.reg(v.Args[1])
	if size < 4 {
		// Divide at 32 bits: the narrow forms use AH.
		ext := MMOVZX
		if signed {
			ext = MMOVSX
		}
		a2, b2 := s.mf.newVReg(ClassGP), s.mf.newVReg(ClassGP)
		s.emit(new(MInst{Op: ext, Size: 4, SrcSize: size, Dst: RegOp(a2), Src: RegOp(a)}))
		s.emit(new(MInst{Op: ext, Size: 4, SrcSize: size, Dst: RegOp(b2), Src: RegOp(b)}))
		a, b = a2, b2
		size = 4
	}
	s.copyReg(RAX, a, 8)
	if signed {
		s.emit(new(MInst{Op: MCQO, Size: size, ImplicitUses: compat.Clone([]Reg{RAX}), ImplicitDefs: compat.Clone([]Reg{RDX})}))
	} else {
		s.emit(new(MInst{Op: MMOV, Size: 4, Dst: RegOp(RDX), Src: ImmOp(0)}))
	}
	op := MDIV
	if signed {
		op = MIDIV
	}
	s.emit(new(MInst{Op: op, Size: size, Src: RegOp(b), ImplicitUses: compat.Clone([]Reg{RAX, RDX}), ImplicitDefs: compat.Clone([]Reg{RAX, RDX})}))
	res := RAX
	if v.Op == ssa.OpMod || v.Op == ssa.OpModu {
		res = RDX
	}
	s.copyReg(s.def(v), res, sizeOf(v.Type))
}

func (s *isel) shift(v *ssa.Value) {
	size := sizeOf(v.Type)
	width := int64(size) * 8
	op := compat.MapAt(compat.MapOf[ssa.Op, MOp](
		compat.Pair[ssa.Op, MOp]{ssa.OpShl, MSHL},
		compat.Pair[ssa.Op, MOp]{ssa.OpShrL, MSHR},
		compat.Pair[ssa.Op, MOp]{ssa.OpShrA, MSAR},
		compat.Pair[ssa.Op, MOp]{ssa.OpRotl, MROL},
	), v.Op)
	d := s.def(v)
	count := v.Args[1]
	if count.Op == ssa.OpConst {
		c := count.AuxInt
		switch {
		case v.Op == ssa.OpRotl:
			c &= width - 1
		case uint64(c) >= uint64(width) && v.Op == ssa.OpShrA:
			c = width - 1
		case uint64(c) >= uint64(width):
			s.loadConst(d, 0, size)
			return
		}
		s.copyReg(d, s.reg(v.Args[0]), size)
		if c != 0 {
			s.emit(new(MInst{Op: op, Size: size, Dst: RegOp(d), Src: ImmOp(c)}))
		}
		return
	}
	cnt := s.reg(count)
	if v.Op == ssa.OpShrA {
		// Clamp the count to width-1 so large counts fill with the sign.
		limit := s.mf.newVReg(ClassGP)
		s.loadConst(limit, width-1, 8)
		c2 := s.mf.newVReg(ClassGP)
		s.copyReg(c2, cnt, 8)
		s.emit(new(MInst{Op: MCMP, Size: 8, Dst: RegOp(c2), Src: ImmOp(width - 1)}))
		s.emit(new(MInst{Op: MCMOVCC, Size: 8, Cond: CondA, Dst: RegOp(c2), Src: RegOp(limit)}))
		cnt = c2
	}
	s.copyReg(d, s.reg(v.Args[0]), size)
	s.copyReg(RCX, cnt, 8)
	s.emit(new(MInst{Op: op, Size: size, Dst: RegOp(d), Src: RegOp(RCX)}))
	if v.Op == ssa.OpShl || v.Op == ssa.OpShrL {
		// Counts of at least the width give zero.
		zero := s.mf.newVReg(ClassGP)
		s.loadConst(zero, 0, 8)
		s.emit(new(MInst{Op: MCMP, Size: 8, Dst: RegOp(cnt), Src: ImmOp(width)}))
		s.emit(new(MInst{Op: MCMOVCC, Size: max(size, 4), Cond: CondAE, Dst: RegOp(d), Src: RegOp(zero)}))
	}
}

// ----------------------------------------------------------------------------
// Comparisons and selects

// intCompare emits a CMP for an integer comparison and returns the condition
// under which it is true.
func (s *isel) intCompare(v *ssa.Value) Cond {
	a, b := v.Args[0], v.Args[1]
	var cond Cond
	switch v.Op {
	case ssa.OpEq:
		cond = CondE
	case ssa.OpNe:
		cond = CondNE
	case ssa.OpLess:
		cond = CondL
	case ssa.OpLeq:
		cond = CondLE
	case ssa.OpLessu:
		cond = CondB
	case ssa.OpLequ:
		cond = CondBE
	}
	if a.Op == ssa.OpConst && b.Op != ssa.OpConst {
		a, b = b, a
		cond = swapCond(cond)
	}
	if bt := bitTestOf(v); bt != nil && s.fused[bt.ID] {
		// mask >> x is zero for x >= 64, which bt (taking x mod 64) does
		// not know: clear the mask for those first.
		shr := bt.Args[0]
		x := s.reg(shr.Args[1])
		m := s.newReg(ssa.TI64)
		s.loadConst(m, shr.Args[0].AuxInt, 8)
		z := s.newReg(ssa.TI64)
		s.loadConst(z, 0, 8)
		s.emit(new(MInst{Op: MCMP, Size: 8, Dst: RegOp(x), Src: ImmOp(64)}))
		s.emit(new(MInst{Op: MCMOVCC, Size: 8, Cond: CondAE, Dst: RegOp(m), Src: RegOp(z)}))
		s.emit(new(MInst{Op: MBT, Size: 8, Dst: RegOp(m), Src: RegOp(x)}))
		if cond == CondNE {
			return CondB // the bit, in CF, is set
		}
		return CondAE
	}
	size := sizeOf(a.Type)
	if b.Op == ssa.OpConst && b.AuxInt == 0 && (cond == CondE || cond == CondNE) {
		if a.Op == ssa.OpAnd && s.fused[a.ID] {
			// x&y == 0 is TEST x, y.
			x, y := a.Args[0], a.Args[1]
			if x.Op == ssa.OpConst {
				x, y = y, x
			}
			s.emit(new(MInst{Op: MTEST, Size: size, Dst: RegOp(s.reg(x)), Src: s.operand(y)}))
			return cond
		}
		r := s.reg(a)
		s.emit(new(MInst{Op: MTEST, Size: size, Dst: RegOp(r), Src: RegOp(r)}))
		return cond
	}
	s.emit(new(MInst{Op: MCMP, Size: size, Dst: RegOp(s.reg(a)), Src: s.operand(b)}))
	return cond
}

// swapCond returns the condition for the comparison with operands swapped.
func swapCond(c Cond) Cond {
	switch c {
	case CondL:
		return CondG
	case CondLE:
		return CondGE
	case CondG:
		return CondL
	case CondGE:
		return CondLE
	case CondB:
		return CondA
	case CondBE:
		return CondAE
	case CondA:
		return CondB
	case CondAE:
		return CondBE
	}
	return c
}

// floatCompare emits UCOMIS for a float comparison and returns the
// condition, plus for == and != the parity condition that must also hold
// (NP) or may alternatively hold (P).
func (s *isel) floatCompare(v *ssa.Value) (cond Cond, parity Cond, needParity bool) {
	a, b := v.Args[0], v.Args[1]
	size := sizeOf(a.Type)
	switch v.Op {
	case ssa.OpFLess: // a < b  <=>  b > a
		s.emit(new(MInst{Op: MUCOMI, Size: size, Dst: RegOp(s.reg(b)), Src: RegOp(s.reg(a))}))
		return CondA, 0, false
	case ssa.OpFLeq:
		s.emit(new(MInst{Op: MUCOMI, Size: size, Dst: RegOp(s.reg(b)), Src: RegOp(s.reg(a))}))
		return CondAE, 0, false
	case ssa.OpFEq:
		s.emit(new(MInst{Op: MUCOMI, Size: size, Dst: RegOp(s.reg(a)), Src: RegOp(s.reg(b))}))
		return CondE, CondNP, true
	default: // FNe
		s.emit(new(MInst{Op: MUCOMI, Size: size, Dst: RegOp(s.reg(a)), Src: RegOp(s.reg(b))}))
		return CondNE, CondP, true
	}
}

// setcc sets d to the flag condition, as 0 or 1 in all of d. SETcc writes
// only the low byte, which would make it wait for d's old value; clearing
// d first with a MOV (which keeps the flags) removes that dependency.
func (s *isel) setcc(d Reg, cond Cond) {
	s.emit(new(MInst{Op: MMOV, Size: 4, Dst: RegOp(d), Src: ImmOp(0)}))
	s.emit(new(MInst{Op: MSETCC, Size: 1, Dst: RegOp(d), Cond: cond}))
}

func (s *isel) floatCompareValue(v *ssa.Value) {
	cond, parity, two := s.floatCompare(v)
	d := s.def(v)
	s.setcc(d, cond)
	if two {
		t := s.mf.newVReg(ClassGP)
		s.setcc(t, parity)
		op := MAND
		if v.Op == ssa.OpFNe {
			op = MOR
		}
		s.emit(new(MInst{Op: op, Size: 1, Dst: RegOp(d), Src: RegOp(t)}))
	}
}

func (s *isel) selectValue(v *ssa.Value) {
	c, a, b := v.Args[0], v.Args[1], v.Args[2]
	if v.Type.IsFloat() {
		panic("amd64: float Select reached instruction selection")
	}
	size := max(sizeOf(v.Type), 4)
	ra, rb := s.reg(a), s.reg(b)
	d := s.def(v)
	var cond Cond
	switch {
	case isCompare(c.Op) && !c.Args[0].Type.IsFloat() && s.vregs[c.ID] == NoReg && c.Block == v.Block:
		s.copyReg(d, rb, size)
		cond = s.intCompare(c)
	case isCompare(c.Op) && c.Args[0].Type.IsFloat() && c.Op != ssa.OpFEq && c.Op != ssa.OpFNe && s.vregs[c.ID] == NoReg && c.Block == v.Block:
		s.copyReg(d, rb, size)
		cond, _, _ = s.floatCompare(c)
	default:
		rc := s.reg(c)
		s.copyReg(d, rb, size)
		s.emit(new(MInst{Op: MTEST, Size: 1, Dst: RegOp(rc), Src: RegOp(rc)}))
		cond = CondNE
	}
	s.emit(new(MInst{Op: MCMOVCC, Size: size, Cond: cond, Dst: RegOp(d), Src: RegOp(ra)}))
}

// ----------------------------------------------------------------------------
// Bit operations

func (s *isel) bitScan(v *ssa.Value) {
	size := sizeOf(v.Type)
	src := s.reg(v.Args[0])
	opSize := size
	if size < 4 {
		// Widen: zero-extend so the scan sees only the value's bits.
		w := s.mf.newVReg(ClassGP)
		s.emit(new(MInst{Op: MMOVZX, Size: 4, SrcSize: size, Dst: RegOp(w), Src: RegOp(src)}))
		src = w
		opSize = 4
	}
	width := int64(size) * 8
	d := s.def(v)
	t := s.mf.newVReg(ClassGP)
	if v.Op == ssa.OpCtz {
		s.emit(new(MInst{Op: MBSF, Size: opSize, Dst: RegOp(d), Src: RegOp(src)}))
		s.loadConst(t, width, 8)
		s.emit(new(MInst{Op: MCMOVCC, Size: max(opSize, 4), Cond: CondE, Dst: RegOp(d), Src: RegOp(t)}))
		return
	}
	// clz = (opWidth-1) - bsr, adjusted for widening; zero gives width.
	s.emit(new(MInst{Op: MBSR, Size: opSize, Dst: RegOp(d), Src: RegOp(src)}))
	s.loadConst(t, -1, 8)
	s.emit(new(MInst{Op: MCMOVCC, Size: max(opSize, 4), Cond: CondE, Dst: RegOp(d), Src: RegOp(t)}))
	// d = width-1 - d  (d is -1 for zero, giving width)
	r := s.mf.newVReg(ClassGP)
	s.loadConst(r, width-1, 8)
	s.emit(new(MInst{Op: MSUB, Size: max(opSize, 4), Dst: RegOp(r), Src: RegOp(d)}))
	s.vregs[v.ID] = r
	s.mf.regClass.Set(r, ClassGP)
}

// popCount emits the SWAR population count (baseline x86-64 has no POPCNT).
func (s *isel) popCount(v *ssa.Value) {
	size := sizeOf(v.Type)
	x := s.mf.newVReg(ClassGP)
	if size < 8 {
		if size == 4 {
			s.emit(new(MInst{Op: MMOV, Size: 4, Dst: RegOp(x), Src: RegOp(s.reg(v.Args[0]))}))
		} else {
			s.emit(new(MInst{Op: MMOVZX, Size: 4, SrcSize: size, Dst: RegOp(x), Src: RegOp(s.reg(v.Args[0]))}))
		}
	} else {
		s.copyReg(x, s.reg(v.Args[0]), 8)
	}
	tmp := func() Reg { return s.mf.newVReg(ClassGP) }
	k := func(c int64) Reg {
		r := tmp()
		s.emit(new(MInst{Op: MMOV, Size: 8, Dst: RegOp(r), Src: ImmOp(c)}))
		return r
	}
	// x -= (x >> 1) & 0x5555...
	t := tmp()
	s.copyReg(t, x, 8)
	s.emit(new(MInst{Op: MSHR, Size: 8, Dst: RegOp(t), Src: ImmOp(1)}))
	s.emit(new(MInst{Op: MAND, Size: 8, Dst: RegOp(t), Src: RegOp(k(0x5555555555555555))}))
	s.emit(new(MInst{Op: MSUB, Size: 8, Dst: RegOp(x), Src: RegOp(t)}))
	// x = (x & 0x3333...) + ((x >> 2) & 0x3333...)
	m3 := k(0x3333333333333333)
	t2 := tmp()
	s.copyReg(t2, x, 8)
	s.emit(new(MInst{Op: MSHR, Size: 8, Dst: RegOp(t2), Src: ImmOp(2)}))
	s.emit(new(MInst{Op: MAND, Size: 8, Dst: RegOp(t2), Src: RegOp(m3)}))
	s.emit(new(MInst{Op: MAND, Size: 8, Dst: RegOp(x), Src: RegOp(m3)}))
	s.emit(new(MInst{Op: MADD, Size: 8, Dst: RegOp(x), Src: RegOp(t2)}))
	// x = (x + (x >> 4)) & 0x0f0f...
	t3 := tmp()
	s.copyReg(t3, x, 8)
	s.emit(new(MInst{Op: MSHR, Size: 8, Dst: RegOp(t3), Src: ImmOp(4)}))
	s.emit(new(MInst{Op: MADD, Size: 8, Dst: RegOp(x), Src: RegOp(t3)}))
	s.emit(new(MInst{Op: MAND, Size: 8, Dst: RegOp(x), Src: RegOp(k(0x0f0f0f0f0f0f0f0f))}))
	// x = (x * 0x0101...) >> 56
	s.emit(new(MInst{Op: MIMUL, Size: 8, Dst: RegOp(x), Src: RegOp(k(0x0101010101010101))}))
	s.emit(new(MInst{Op: MSHR, Size: 8, Dst: RegOp(x), Src: ImmOp(56)}))
	s.vregs[v.ID] = x
}

// ----------------------------------------------------------------------------
// Block memory operations

func (s *isel) zero(p *ssa.Value, n int64) {
	if n <= 64 {
		m := s.addr(p)
		for off := int64(0); off < n; {
			step := chunk(n - off)
			mm := m
			mm.Disp += off
			s.emit(new(MInst{Op: MMOV, Size: uint8(step), Dst: MemOp(mm), Src: ImmOp(0)}))
			off += step
		}
		return
	}
	s.lea(RDI, s.addr(p))
	s.loadConst(RCX, n, 8)
	s.loadConst(RAX, 0, 8)
	s.emit(new(MInst{Op: MREPSTOSB, ImplicitUses: compat.Clone([]Reg{RDI, RCX, RAX}), ImplicitDefs: compat.Clone([]Reg{RDI, RCX})}))
}

func (s *isel) move(dst, src *ssa.Value, n int64) {
	if n <= 64 {
		dm := s.addr(dst)
		sm := s.addr(src)
		for off := int64(0); off < n; {
			step := chunk(n - off)
			t := s.mf.newVReg(ClassGP)
			a := sm
			a.Disp += off
			b := dm
			b.Disp += off
			s.emit(new(MInst{Op: MMOV, Size: uint8(step), Dst: RegOp(t), Src: MemOp(a)}))
			s.emit(new(MInst{Op: MMOV, Size: uint8(step), Dst: MemOp(b), Src: RegOp(t)}))
			off += step
		}
		return
	}
	s.lea(RDI, s.addr(dst))
	s.lea(RSI, s.addr(src))
	s.loadConst(RCX, n, 8)
	s.emit(new(MInst{Op: MREPMOVSB, ImplicitUses: compat.Clone([]Reg{RDI, RSI, RCX}), ImplicitDefs: compat.Clone([]Reg{RDI, RSI, RCX})}))
}

// chunk returns the largest power-of-two access size (at most 8) <= n.
func chunk(n int64) int64 {
	switch {
	case n >= 8:
		return 8
	case n >= 4:
		return 4
	case n >= 2:
		return 2
	}
	return 1
}

// ----------------------------------------------------------------------------
// Calls

func (s *isel) call(v *ssa.Value) {
	info := v.Call
	args := v.Args[:len(v.Args)-1] // drop memory
	var target Operand
	var ctx *ssa.Value
	if v.Op == ssa.OpCallInd {
		target = RegOp(s.reg(args[0]))
		ctx = args[1]
		args = args[2:]
	}
	types := make([]*ssa.Type, len(args))
	for i, a := range args {
		types[i] = a.Type
	}
	locs, stack := abiLocs(types, intArgRegs, floatArgRegs, info.OnStack)
	s.mf.outArgs = max(s.mf.outArgs, stack)

	// Stack arguments first (they may need registers to compute), then
	// register arguments, so argument registers are not clobbered.
	for i, a := range args {
		if locs[i].reg == NoReg {
			s.store(Mem{Base: NoReg, Index: NoReg, OutArg: true, Disp: locs[i].stack}, a)
		}
	}
	srcs := make([]Reg, len(args))
	for i, a := range args {
		if locs[i].reg != NoReg {
			srcs[i] = s.reg(a)
		}
	}
	ctxReg := NoReg
	if ctx != nil {
		ctxReg = s.reg(ctx)
	}
	var uses []Reg
	for i := range args {
		if l := locs[i].reg; l != NoReg {
			s.copyReg(l, srcs[i], 8)
			uses = compat.Append(uses, l)
		}
	}
	if ctx != nil {
		s.copyReg(closureReg, ctxReg, 8)
		uses = compat.Append(uses, closureReg)
	}
	if info.ABI == ssa.ABIC && info.Variadic {
		nf := 0
		for _, l := range locs {
			if l.reg >= X0 && l.reg <= X15 {
				nf++
			}
		}
		s.loadConst(RAX, int64(nf), 4)
		uses = compat.Append(uses, RAX)
	}
	in := new(MInst{Op: MCALL, ImplicitUses: uses, ImplicitDefs: compat.Append([]Reg(nil), callerSaved...)})
	if v.Op == ssa.OpCall {
		in.Sym = v.Aux.(*ssa.Sym)
	} else {
		in.Src = target
	}
	s.emit(in)

	// Copy results out of their registers into the SelectN values' registers.
	resRegsInt, resRegsFloat := intResultRegs, floatResultRegs
	if info.ABI == ssa.ABIC {
		resRegsInt, resRegsFloat = intResultRegs[:2], floatResultRegs[:2]
	}
	rlocs, _ := abiLocs(info.Results, resRegsInt, resRegsFloat, nil)
	for _, b := range s.f.Blocks {
		for _, u := range b.Values {
			if u.Op == ssa.OpSelectN && u.Args[0] == v && !u.Type.IsMem() {
				l := rlocs[u.AuxInt-1]
				r := s.newReg(u.Type)
				s.copyReg(r, l.reg, 8)
				s.vregs[u.ID] = r
			}
		}
	}
}

// ----------------------------------------------------------------------------
// Terminators

func (s *isel) terminator(b *ssa.Block) error {
	switch b.Kind {
	case ssa.BlockPlain:
		s.phiCopies(b, b.Succs[0].B, b.Succs[0].I)
		s.emit(new(MInst{Op: MJMP, Target: s.blocks[b.Succs[0].B.ID]}))
	case ssa.BlockIf:
		yes, no := s.blocks[b.Succs[0].B.ID], s.blocks[b.Succs[1].B.ID]
		c := b.Controls[0]
		switch {
		case c.Op == ssa.OpConst && s.vregs[c.ID] == NoReg:
			if c.AuxInt != 0 {
				s.emit(new(MInst{Op: MJMP, Target: yes}))
			} else {
				s.emit(new(MInst{Op: MJMP, Target: no}))
			}
			return nil
		case s.fused[c.ID] && !c.Args[0].Type.IsFloat():
			cond := s.intCompare(c)
			s.emit(new(MInst{Op: MJCC, Cond: cond, Target: yes}))
		case s.fused[c.ID]:
			cond, parity, two := s.floatCompare(c)
			switch {
			case !two:
				s.emit(new(MInst{Op: MJCC, Cond: cond, Target: yes}))
			case c.Op == ssa.OpFEq:
				s.emit(new(MInst{Op: MJCC, Cond: CondNE, Target: no}))
				s.emit(new(MInst{Op: MJCC, Cond: CondP, Target: no}))
				s.emit(new(MInst{Op: MJMP, Target: yes}))
				return nil
			default: // FNe
				s.emit(new(MInst{Op: MJCC, Cond: CondNE, Target: yes}))
				s.emit(new(MInst{Op: MJCC, Cond: parity, Target: yes}))
			}
		default:
			r := s.reg(c)
			s.emit(new(MInst{Op: MTEST, Size: 1, Dst: RegOp(r), Src: RegOp(r)}))
			s.emit(new(MInst{Op: MJCC, Cond: CondNE, Target: yes}))
		}
		s.emit(new(MInst{Op: MJMP, Target: no}))
	case ssa.BlockRet:
		results := b.Controls[1:]
		types := make([]*ssa.Type, len(results))
		for i, r := range results {
			types[i] = r.Type
		}
		resRegsInt, resRegsFloat := intResultRegs, floatResultRegs
		if s.f.ABI == ssa.ABIC {
			resRegsInt, resRegsFloat = intResultRegs[:2], floatResultRegs[:2]
		}
		locs, _ := abiLocs(types, resRegsInt, resRegsFloat, nil)
		srcs := make([]Reg, len(results))
		for i, r := range results {
			srcs[i] = s.reg(r)
		}
		var uses []Reg
		for i := range results {
			s.copyReg(locs[i].reg, srcs[i], 8)
			uses = compat.Append(uses, locs[i].reg)
		}
		s.emit(new(MInst{Op: MEPILOGUE, ImplicitUses: uses}))
	case ssa.BlockExit:
		s.emit(new(MInst{Op: MUD2}))
	default:
		return fmt.Errorf("amd64: block %s has kind %s", b, b.Kind)
	}
	return nil
}

// phiCopies emits the parallel copy into succ's phis for the edge from b,
// which is predecessor number idx of succ.
func (s *isel) phiCopies(b, succ *ssa.Block, idx int) {
	var dsts, srcs []Reg
	for _, v := range succ.Values {
		if v.Op != ssa.OpPhi {
			break
		}
		if v.Type.IsMem() {
			continue
		}
		dsts = compat.Append(dsts, s.vregs[v.ID])
		srcs = compat.Append(srcs, s.reg(v.Args[idx]))
	}
	if len(dsts) > 0 {
		s.emit(new(MInst{Op: MPCOPY, Dsts: dsts, Srcs: srcs}))
	}
}
