func show(f *ssa.Func) {
	fmt.Printf("== %s\n%s", f.Name, f)
	if err := f.Verify(); err != nil {
		fmt.Println("verify:", err)
	}
	d := f.Dom()
	for _, b := range f.Blocks {
		idom := "-"
		if p := d.Idom(b); p != nil {
			idom = p.String()
		}
		fmt.Printf("%s idom=%s reach=%v rpo=%d kids=%d\n", b, idom, d.Reachable(b), d.RPONum(b), len(d.Children(b)))
	}
	df := d.Frontiers(f)
	for _, b := range f.Blocks {
		if len(df[b.ID]) > 0 {
			fmt.Printf("df(%s) =", b)
			for _, c := range df[b.ID] {
				fmt.Printf(" %s", c)
			}
			fmt.Println()
		}
	}
	ln := f.Loops()
	for _, l := range ln.Loops {
		fmt.Printf("loop %s depth=%d blocks=%d exits=%d\n", l.Header, l.Depth, len(l.Blocks), len(l.Exits))
	}
	ssa.CopyElim(f)
	ssa.DeadCode(f)
	ssa.SplitCriticalEdges(f)
	ssa.Schedule(f)
	fmt.Printf("-- after passes\n%s", f)
	fmt.Print("layout:")
	for _, b := range ssa.Layout(f) {
		fmt.Printf(" %s", b)
	}
	fmt.Println()
	if err := f.Verify(); err != nil {
		fmt.Println("verify:", err)
	}
}

