+
+// selfStore is a store pair whose keys name one input, bound to node base
+// (rules.go, "Applying a summary"). The input is one pointer when the call
+// runs, so a pointer the binding holds as a token of its own (tag Root, not
+// tagGE) is both ends' base: the pair applies to each such token alone, not
+// to the product of every token's source with every token's destination (a
+// self-store of memoizing code, a.actual = a.fromRHS, through a value that
+// is heap memory or the caller's input). Any other token (a field of a
+// value, or a tagGE one) applies the pair to the whole binding, as for two
+// inputs.
+type selfStore struct {
+	base  uint32
+	pair  summary.StorePair
+	why   uint64
+	whole bool // applied to the whole binding
+}
+
+// fireSelfStore handles token t of the binding of selfStores[x].
+func (s *solver) fireSelfStore(x int, t tok) {
+	ss := &s.selfStores[x]
+	if t.tag == domain.Root && !t.tagGE {
+		s.storePair(s.tokNode(t), ss.pair, ss.why)
+		return
+	}
+	if !ss.whole {
+		ss.whole = true
+		s.storePair(ss.base, ss.pair, ss.why)
+	}
+}
+
+// storePair applies store pair p with both its inputs bound to node base.
+func (s *solver) storePair(base uint32, p summary.StorePair, why uint64) {
+	dk := p.Dst
+	if dk.FieldsGE() {
+		dk = dk.WithPath(dk.Path(), false)
+	}
+	dst := s.keyNode(base, dk)
+	src := s.keyNode(base, p.Src)
+	if p.Dst.FieldsGE() {
+		src = s.retagNode(src)
+	}
+	s.addCons(dst, cStore, uint64(src), why)
+}
