            // err is a *os.NameError: err.Bytes holds the exact bytes
        }
    To display it, with U+FFFD for each invalid byte:
        s := os.GetenvLossy("HOME")
    To get the exact bytes:
        b := os.GetenvBytes("HOME") // the name is a []byte
    (see "Assignment statements" in the Plutonium spec, section 12.7)
    (run "pluto explain E0017" for a longer explanation)

