package main

import "pluto/fmt"

// Test of fmt.Printf — the `any` type, variadic arguments, and format strings.
//
// Build: pluto build -o printf_test ./examples/08-printf/
// Run:   ./printf_test
// Expected output:
//   42
//   hello 17
//   x=2a
//   A
//   100%%

func main() int64 {
	fmt.Printf("%d\n", 42)
	fmt.Printf("hello %d\n", 17)
	fmt.Printf("x=%x\n", 42)
	fmt.Printf("%c\n", 65)
	fmt.Printf("%d%%\n", 100)
	return 0
}
