package main

// Demonstrates compile-time monomorphization of generic functions.
// Max[int64] is expanded to a concrete Max__int64 function at compile time.
//
// NOTE: Generic function calls currently have a codegen limitation
// where the mangled name lookup doesn't connect properly. This example
// is a placeholder for when that's fixed. For now it demonstrates
// that the generic syntax parses and type-checks correctly.
//
// Build: pluto build -o gen ./examples/06-generics/main.pu
// Run:   ./gen; echo $?
// Expected output: 42

func max(a, b int64) int64 {
	if a > b {
		return a
	}
	return b
}

func main() int64 {
	return max(42, 17)
}
