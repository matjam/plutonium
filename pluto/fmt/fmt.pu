package fmt

import "pluto/io"

// Itoa converts an integer to its decimal string representation.
// Writes the result to the provided byte slice.
// Returns the number of bytes written.
func Itoa(n int64, buf []byte) int {
	if n == 0 {
		if len(buf) > 0 {
			buf[0] = '0'
			return 1
		}
		return 0
	}

	neg := n < 0
	if neg {
		n = -n
	}

	// Write digits in reverse
	i := len(buf) - 1
	pos := i
	for n > 0 && i >= 0 {
		buf[i] = byte('0' + n%10)
		n /= 10
		i--
	}
	if neg && i >= 0 {
		buf[i] = '-'
		i--
	}

	// Reverse the written digits in place
	start := i + 1
	end := pos
	for start < end {
		buf[start], buf[end] = buf[end], buf[start]
		start++
		end--
	}

	return pos - i
}

// Fprint writes a string to w without allocating.
func Fprint(w io.Writer, s string) (int, error) {
	return w.Write([]byte(s))
}

// Fprintln writes a string followed by a newline to w.
func Fprintln(w io.Writer, s string) (int, error) {
	n1, err := w.Write([]byte(s))
	if err != nil {
		return n1, err
	}
	n2, err := w.Write([]byte{'\n'})
	return n1 + n2, err
}

// FprintInt writes an integer in decimal to w.
func FprintInt(w io.Writer, n int64) (int, error) {
	var buf [24]byte
	count := Itoa(n, buf[:])
	return w.Write(buf[:count])
}

// FprintHex writes an integer in hex (0x...) to w.
func FprintHex(w io.Writer, n uint64) (int, error) {
	const hexChars = "0123456789abcdef"
	var buf [18]byte // "0x" + 16 hex digits
	buf[0] = '0'
	buf[1] = 'x'
	for i := 17; i >= 2; i-- {
		buf[i] = hexChars[n&0xF]
		n >>= 4
	}
	return w.Write(buf[:])
}
