package syscall

import "unsafe"

// Linux x86_64 syscall numbers
const (
	SYS_READ         = 0
	SYS_WRITE        = 1
	SYS_OPEN         = 2
	SYS_CLOSE        = 3
	SYS_STAT         = 4
	SYS_FSTAT        = 5
	SYS_MMAP         = 9
	SYS_MUNMAP       = 11
	SYS_BRK          = 12
	SYS_EXIT         = 60
	SYS_EXIT_GROUP   = 231
)

// Errno is a syscall error number.
type Errno uintptr

func (e Errno) Error() string {
	// TODO: error string lookup
	return "syscall error"
}

// Syscall performs a raw Linux syscall with up to 3 arguments.
// Returns r1, r2, errno.
func Syscall(num, a1, a2, a3 uintptr) (r1, r2, err uintptr)

// Syscall6 performs a raw Linux syscall with up to 6 arguments.
func Syscall6(num, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2, err uintptr)
