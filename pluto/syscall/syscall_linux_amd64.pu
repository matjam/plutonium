//pu:build linux && amd64

package syscall

// Linux x86_64 syscall numbers.
// Reference: https://syscalls.mebeim.net/?table=x86/64/x64/v6.7
const (
	SYS_READ         uintptr = 0
	SYS_WRITE        uintptr = 1
	SYS_OPEN         uintptr = 2
	SYS_CLOSE        uintptr = 3
	SYS_STAT         uintptr = 4
	SYS_FSTAT        uintptr = 5
	SYS_LSTAT        uintptr = 6
	SYS_POLL         uintptr = 7
	SYS_LSEEK        uintptr = 8
	SYS_MMAP         uintptr = 9
	SYS_MPROTECT     uintptr = 10
	SYS_MUNMAP       uintptr = 11
	SYS_BRK          uintptr = 12
	SYS_IOCTL        uintptr = 16
	SYS_PIPE         uintptr = 22
	SYS_DUP          uintptr = 32
	SYS_DUP2         uintptr = 33
	SYS_NANOSLEEP    uintptr = 35
	SYS_GETPID       uintptr = 39
	SYS_SOCKET       uintptr = 41
	SYS_CONNECT      uintptr = 42
	SYS_ACCEPT       uintptr = 43
	SYS_SENDTO       uintptr = 44
	SYS_RECVFROM     uintptr = 45
	SYS_BIND         uintptr = 49
	SYS_LISTEN       uintptr = 50
	SYS_FORK         uintptr = 57
	SYS_EXECVE       uintptr = 59
	SYS_EXIT         uintptr = 60
	SYS_WAIT4        uintptr = 61
	SYS_KILL         uintptr = 62
	SYS_GETDENTS64   uintptr = 217
	SYS_SET_TID_ADDR uintptr = 218
	SYS_EXIT_GROUP   uintptr = 231
	SYS_OPENAT       uintptr = 257
	SYS_NEWFSTATAT   uintptr = 262
	SYS_UNLINKAT     uintptr = 263
	SYS_MKDIRAT      uintptr = 258
)
