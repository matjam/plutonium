package os

// Standard file descriptors. These values are the same on all hosted OSes.
const (
	Stdin  = 0
	Stdout = 1
	Stderr = 2
)

// Common open(2) flags. Values are OS-specific and defined in os_linux.pu etc.
// These constants are declared here as a stable API; the values are supplied
// by the OS-specific files via separate const blocks.
