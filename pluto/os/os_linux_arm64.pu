//pu:build linux && arm64

package os

import (
	"pluto/syscall"
	"unsafe"
)

// Open opens a file.
// On aarch64 Linux, open(2) does not exist — use openat(2) with AT_FDCWD.
func Open(name string, flags int, perm uint32) (int, error) {
	nameBytes := []byte(name)
	nameBytes = append(nameBytes, 0) // null-terminate
	fd, _, errno := syscall.Syscall6(
		syscall.SYS_OPENAT,
		syscall.AT_FDCWD,
		uintptr(unsafe.Pointer(&nameBytes[0])),
		uintptr(flags),
		uintptr(perm),
		0,
		0,
	)
	if errno != 0 {
		return -1, syscall.Errno(errno)
	}
	return int(fd), nil
}
