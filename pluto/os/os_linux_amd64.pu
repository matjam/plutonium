//pu:build linux && amd64

package os

import (
	"pluto/syscall"
	"unsafe"
)

// Open opens a file.
// On x86_64 Linux, open(2) is available directly (syscall 2).
func Open(name string, flags int, perm uint32) (int, error) {
	nameBytes := []byte(name)
	nameBytes = append(nameBytes, 0) // null-terminate
	fd, _, errno := syscall.Syscall(
		syscall.SYS_OPEN,
		uintptr(unsafe.Pointer(&nameBytes[0])),
		uintptr(flags),
		uintptr(perm),
	)
	if errno != 0 {
		return -1, syscall.Errno(errno)
	}
	return int(fd), nil
}
